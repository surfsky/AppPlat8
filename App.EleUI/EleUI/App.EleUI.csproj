<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <PackageId>App.EleUI</PackageId>
    <Version>8.0.0</Version>
    <Authors>AppPlat Team</Authors>
    <Company>AppPlat</Company>
    <Description>Razor TagHelpers + Vue3/ElementPlus runtime for AppPlat EleUI.</Description>
    <PackageTags>razor;taghelper;vue;element-plus;ui</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\App.Utils\App.Utils\App.Utils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 增量构建开关：默认 true；命令行可 /p:BuildEleUI=false 强制跳过 -->
    <BuildEleUI Condition="'$(BuildEleUI)' == ''">true</BuildEleUI>
    <EleUiMarkerFile>node_modules/.npm-installed-marker</EleUiMarkerFile>
  </PropertyGroup>

  <!-- 先把前端源码 Glob 展开成 Item，再在 Target Inputs 里引用，跨平台最稳 -->
  <ItemGroup>
    <EleUiSrc Include="build.mjs" />
    <EleUiSrc Include="package.json" />
    <EleUiSrc Include="EleUIJs/**/*.js" />
    <EleUiSrc Include="EleUIJs/**/*.css" />
  </ItemGroup>

  <!-- 仅当 package.json / package-lock.json 变动时才 npm install，跑一次 touch marker -->
  <Target Name="InstallEleUiDeps"
          Condition="$(BuildEleUI) == true"
          BeforeTargets="BuildEleUiAssets"
          Inputs="package.json;package-lock.json"
          Outputs="$(EleUiMarkerFile)">
    <Message Importance="high" Text="[EleUI] npm install (deps changed)" />
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Touch Files="$(EleUiMarkerFile)" AlwaysCreate="true" />
  </Target>

  <!-- 仅当前端源码变动时才 npm run build（@(EleUiSrc) 里任何文件比 Outputs 新即触发） -->
  <Target Name="BuildEleUiAssets"
          Condition="$(BuildEleUI) == true"
          BeforeTargets="Build"
          DependsOnTargets="InstallEleUiDeps"
          Inputs="@(EleUiSrc);$(EleUiMarkerFile)"
          Outputs="wwwroot/eleui/eleui.js;wwwroot/eleui/eleui.js.map">
    <Message Importance="high" Text="[EleUI] npm run build (assets changed)" />
    <Exec Command="node ./build.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>