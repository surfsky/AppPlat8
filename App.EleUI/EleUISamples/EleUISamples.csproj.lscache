/optimize-
/out:obj/Debug/net8.0/EleUISamples.dll
/refout:obj/Debug/net8.0/refint/EleUISamples.dll
/target:exe
/warnaserror-
/utf8output
/deterministic+
/langversion:12.0
/warnaserror+:NU1605,SYSLIB0011

