@page
@model App.Pages.KB.MenuFormModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "知识库目录信息";
}

@section body {
    <EleForm LabelWidth="120px">
        <EleInput For="Item.Name" Label="名称" Required="true"></EleInput>
        <EleTreePicker For="Item.ParentId" Label="上级目录" Items="Model.MenuTree" Clearable="true"></EleTreePicker>
        <EleTreePicker For="Item.OrgId" Label="归属组织" Api="/httpapi/orgs/GetAuthOrgTree" IdField="id" NameField="name" Clearable="true" CheckStrictly="true"></EleTreePicker>
        <EleNumber For="Item.SortId" Label="排序"></EleNumber>
    
        <Bottom>
            <EleButton Type="Primary" Command="SaveClose" Visible="@(Model.Mode != PageMode.View)">保存</EleButton>
            <EleButton Type="Primary" Command="SaveNew" Visible="@(Model.Mode != PageMode.View)">保存并新增</EleButton>
            <EleButton Command="Close">关闭</EleButton>
        </Bottom>
    </EleForm>
}
