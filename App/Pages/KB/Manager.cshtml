@page
@model App.Pages.KB.ManagerModel
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "知识库管理（原生 Vue 版）";
    var currentId = Model.CurrentMenuId ?? 0;
    // 权限：统一写成 JS 可识别的小写字符串 "true" / "false"，
    // 因为 Manager3 是原生 Vue，@(xxx) 会直接输出到 JS 源码里，
    // 字符串版不会触发 JS 的关键字/大小写问题，也能无缝配合 !currentMenuId 这种 JS 逻辑。
    var canNew    = Auth.CheckPower(Power.KbMenuNew)    ? "true" : "false";
    var canEdit   = Auth.CheckPower(Power.KbMenuEdit)   ? "true" : "false";
    var canDelete = Auth.CheckPower(Power.KbMenuDelete) ? "true" : "false";
    var canUploadDir = (Auth.CheckPower(Power.KbMenuNew) || Auth.CheckPower(Power.KbMenuEdit)) ? "true" : "false";
    var defaultIframeUrl = Model.DefaultAttsUrl;
    var treeJson = JsonSerializer.Serialize(
        Model.MenuTree ?? new List<KbMenu>(),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase, WriteIndented = false,
            ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles, MaxDepth = 64 });
}

@section head {
    <style>
        .kb-manager-shell {
            height: 100%;
            width: 100%;
            min-width: 0;
            min-height: 0;
            background: #fff;
            display: flex;
            flex-direction: column;
        }

        .kb-manager-split-shell {
            height: 100%;
            width: 100%;
            min-width: 0;
            min-height: 0;
            flex: 1 1 auto;
            display: flex;
            flex-direction: row;
            position: relative;
            background: #fff;
        }

        .kb-manager-split-panel {
            height: 100%;
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: #fff;
        }

        .kb-manager-split-panel[data-role="aside"] {
            flex: 0 0 auto;
            border-right: 1px solid #f1f5f9;
        }

        .kb-manager-split-panel[data-role="content"] {
            flex: 1 1 auto;
        }

        .kb-manager-split-bar {
            position: relative;
            flex: 0 0 10px;
            width: 10px;
            height: 100%;
            cursor: col-resize;
            background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
            border-left: 1px solid #eef2f7;
            border-right: 1px solid #eef2f7;
            transition: background-color .15s ease;
            user-select: none;
            -webkit-user-select: none;
            z-index: 3;
        }

        .kb-manager-split-bar:hover,
        .kb-manager-split-bar.is-active {
            background: linear-gradient(180deg, #eff6ff 0%, #dbeafe 100%);
        }

        .kb-manager-split-bar::after {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 20px;
            height: 40px;
            border-radius: 10px;
            background: #fff;
            border: 1px solid #dbeafe;
            box-shadow: 0 1px 3px rgba(15, 23, 42, .08);
        }

        .kb-manager-split-bar:hover::after,
        .kb-manager-split-bar.is-active::after {
            background: #eff6ff;
        }

        .kb-manager-collapse-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 20px;
            height: 20px;
            border: none;
            background: transparent;
            color: #475569;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            z-index: 2;
            padding: 0;
            font-size: 12px;
            line-height: 1;
        }

        .kb-manager-collapse-btn:hover {
            background: rgba(59, 130, 246, .1);
            color: #1d4ed8;
        }

        .kb-manager-panel-fill {
            height: 100%;
            width: 100%;
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: #fff;
        }

        .kb-manager-tree-panel {}

        .kb-manager-mobile-shell {
            height: 100%;
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: #fff;
        }

        .kb-manager-empty {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            padding: 24px;
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        }

        .kb-manager-empty-card {
            width: min(420px, 100%);
            padding: 28px 24px;
            border: 1px dashed #cbd5e1;
            border-radius: 16px;
            background: rgba(248, 250, 252, .92);
            text-align: center;
            color: #475569;
            /*box-shadow: 0 12px 30px rgba(15, 23, 42, .06);*/
        }

        .kb-manager-empty-card h3 {
            margin: 0 0 10px;
            font-size: 16px;
            font-weight: 600;
            color: #0f172a;
        }

        .kb-manager-empty-card p {
            margin: 0;
            line-height: 1.7;
            font-size: 13px;
        }

        .kb-manager-mobile-tip {
            margin: 8px 12px 0;
            padding: 10px 12px;
            border-radius: 10px;
            background: #f8fafc;
            color: #64748b;
            font-size: 12px;
            line-height: 1.6;
        }
    </style>
}

@section body {
    <div id="kbMgr3" class="h-screen w-screen max-w-full overflow-hidden min-h-0 min-w-0">
        <input id="kbDirUploadInput" type="file" style="display:none" webkitdirectory directory multiple @@change="onDirectorySelected" />
        <div class="kb-manager-shell h-full">
            <div
                v-if="!isMobileLayout"
                class="kb-manager-split-shell"
                ref="splitShellRef">
                <div
                    class="kb-manager-split-panel kb-manager-tree-panel"
                    data-role="aside"
                    :style="{ width: asideCollapsed ? '0px' : asideWidth + 'px', visibility: asideCollapsed ? 'hidden' : 'visible' }">
                    <div class="kb-manager-panel-fill">
                        <div class="flex items-center justify-between px-3 py-2 border-b border-gray-100 shrink-0">
                            <div class="flex gap-1">
                                <el-button v-if="canNew" type="primary" circle @@click="onNewMenu" title="新建子目录">
                                    <i class="fa-solid fa-plus" style="font-size:14px;"></i>
                                </el-button>
                                <el-button v-if="canUploadDir" type="warning" circle @@click="onOpenUploadDirectory" title="上传目录">
                                    <i class="fa-solid fa-folder-plus" style="font-size:14px;"></i>
                                </el-button>
                                <el-button v-if="canEdit" type="success" circle :disabled="!currentMenuId" @@click="onEditMenu" title="编辑目录">
                                    <i class="fa-solid fa-pen" style="font-size:14px;"></i>
                                </el-button>
                                <el-button v-if="canDelete" type="danger" circle :disabled="!currentMenuId" @@click="onDeleteMenu" title="删除目录">
                                    <i class="fa-solid fa-trash" style="font-size:14px;"></i>
                                </el-button>
                                <el-button v-if="canEdit" circle :disabled="!currentMenuId" @@click="onMoveUp" title="上移">
                                    <i class="fa-solid fa-arrow-up" style="font-size:14px;"></i>
                                </el-button>
                                <el-button v-if="canEdit" circle :disabled="!currentMenuId" @@click="onMoveDown" title="下移">
                                    <i class="fa-solid fa-arrow-down" style="font-size:14px;"></i>
                                </el-button>
                            </div>
                        </div>
                        <div class="flex-1 min-h-0 min-w-0 overflow-auto px-2 py-1">
                            <el-tree
                                ref="treeRef"
                                :data="treeData"
                                node-key="id"
                                :default-expand-all="false"
                                :default-expanded-keys="defaultExpandedKeys"
                                :expand-on-click-node="false"
                                :highlight-current="true"
                                :current-node-key="currentMenuId"
                                @@node-click="onTreeSelect">
                                <template #default="{ node, data }">
                                    <span
                                        @@click.stop.prevent="onTreeSelect(data)"
                                        :class="[
                                            'inline-flex items-center w-full px-1 py-0.5 rounded cursor-pointer transition',
                                            currentMenuId === data.id ? 'font-semibold text-indigo-700 bg-indigo-50' : 'text-gray-800 hover:bg-gray-50'
                                        ]">
                                        <span class="truncate">{{ data.name || data.label || '未命名' }}</span>
                                    </span>
                                </template>
                            </el-tree>
                        </div>
                    </div>
                </div>

                <div
                    class="kb-manager-split-bar"
                    :class="{ 'is-active': isResizing }"
                    role="separator"
                    :aria-valuenow="asideWidth"
                    :aria-valuemin="MIN_ASIDE_WIDTH"
                    :aria-valuemax="MAX_ASIDE_WIDTH"
                    @@mousedown="onSplitBarMouseDown">
                    <button
                        type="button"
                        class="kb-manager-collapse-btn"
                        :title="asideCollapsed ? '展开目录' : '收起目录'"
                        @@mousedown.stop
                        @@click.stop="onToggleCollapse">
                        <i :class="asideCollapsed ? 'fa-solid fa-angle-right' : 'fa-solid fa-angle-left'" aria-hidden="true"></i>
                    </button>
                </div>

                <div
                    class="kb-manager-split-panel"
                    data-role="content">
                    <div class="kb-manager-panel-fill">
                        <div v-if="!hasSelection" class="kb-manager-empty">
                            <div class="kb-manager-empty-card">
                                <h3>请选择左侧目录</h3>
                            </div>
                        </div>
                        <iframe
                            v-else
                            id="kbAttsFrame3"
                            :class="{ 'pointer-events-none': isResizing }"
                            class="w-full h-full block bg-white border-0 flex-1 min-w-0 min-h-0"
                            frameborder="0"
                            :src="attsUrl">
                        </iframe>
                    </div>
                </div>
            </div>

            <aside
                v-else
                class="kb-manager-mobile-shell"
                :style="{ width: '100%' }">
                <div class="flex items-center justify-between px-3 py-2 border-b border-gray-100 shrink-0">
                    <div class="flex gap-1">
                        <el-button v-if="canNew" type="primary" circle @@click="onNewMenu" title="新建子目录">
                            <i class="fa-solid fa-plus" style="font-size:14px;"></i>
                        </el-button>
                        <el-button v-if="canUploadDir" type="warning" circle @@click="onOpenUploadDirectory" title="上传目录">
                            <i class="fa-solid fa-folder-plus" style="font-size:14px;"></i>
                        </el-button>
                        <el-button v-if="canEdit" type="success" circle :disabled="!currentMenuId" @@click="onEditMenu" title="编辑目录">
                            <i class="fa-solid fa-pen" style="font-size:14px;"></i>
                        </el-button>
                        <el-button v-if="canDelete" type="danger" circle :disabled="!currentMenuId" @@click="onDeleteMenu" title="删除目录">
                            <i class="fa-solid fa-trash" style="font-size:14px;"></i>
                        </el-button>
                        <el-button v-if="canEdit" circle :disabled="!currentMenuId" @@click="onMoveUp" title="上移">
                            <i class="fa-solid fa-arrow-up" style="font-size:14px;"></i>
                        </el-button>
                        <el-button v-if="canEdit" circle :disabled="!currentMenuId" @@click="onMoveDown" title="下移">
                            <i class="fa-solid fa-arrow-down" style="font-size:14px;"></i>
                        </el-button>
                    </div>
                </div>
                <div class="flex-1 min-h-0 overflow-auto px-2 py-1">
                    <el-tree
                        ref="treeRef"
                        :data="treeData"
                        node-key="id"
                        :default-expand-all="false"
                        :default-expanded-keys="defaultExpandedKeys"
                        :expand-on-click-node="false"
                        :highlight-current="true"
                        :current-node-key="currentMenuId"
                        @@node-click="onTreeSelect">
                        <template #default="{ node, data }">
                            <span
                                @@click.stop.prevent="onTreeSelect(data)"
                                :class="[
                                    'inline-flex items-center w-full px-1 py-0.5 rounded cursor-pointer transition',
                                    currentMenuId === data.id ? 'font-semibold text-indigo-700 bg-indigo-50' : 'text-gray-800 hover:bg-gray-50'
                                ]">
                                <span class="truncate">{{ data.name || data.label || '未命名' }}</span>
                            </span>
                        </template>
                    </el-tree>
                </div>
            </aside>
        </div>
    </div>
}

@section script {
    <script>
        // Manager3：完整的原生 Vue 3 + Element Plus 实现（完全不用 EleUI TagHelper）
        // - 用 Vue.createApp + ElementPlus + icons-vue 自己挂载
        // - 按钮 / Tree / Container 全是原生标签
        // - 与 Manager 页面一样：switchMenu 用 pushState + iframe.src 切换；同节点重复点击不操作
        // - 服务器端仍复用 ManagerModel 的 OnPostXxx handler，通过 axios POST + RequestVerificationToken 调用
        // - 关闭弹窗 / 保存成功后的刷新：通过 window.mgr3ReloadPage

        (function () {
            // axios 全局（Layout 已经加载过一次，做兼容判断）
            const http = (typeof axios !== 'undefined' && axios)
                ? axios
                : (window.axios || null);

            const initialTreeData = @Html.Raw(treeJson);
            const initialCurrentId = @(currentId > 0 ? currentId.ToString() : "0");
            const defaultAttsIframeUrl = "@Html.Raw(defaultIframeUrl.Replace("\"", "\\\""))";
            // Razor 里 canNew/canEdit/canDelete 定义为字符串 "true" / "false"，直接 Razor 输出即得到 JS 字面量
            const canNewFlag = @canNew;
            const canEditFlag = @canEdit;
            const canDeleteFlag = @canDelete;
            const canUploadDirFlag = @canUploadDir;
            const HANDLERS = {
                Delete:   'DeleteMenu',
                MoveUp:   'MenuMoveUp',
                MoveDown: 'MenuMoveDown',
                UploadDirectory: 'UploadDirectory'
            };
            // 默认展开层数：0=全部折叠，1=只展开根，2=根+子级，3=根+子级+孙级...
            const DEFAULT_EXPAND_TREE_LEVEL = 1;
            const DESKTOP_BREAKPOINT = 992;
            const DEFAULT_ASIDE_WIDTH = 300;
            const MIN_ASIDE_WIDTH = 220;
            const MAX_ASIDE_WIDTH = 520;
            const MIN_CONTENT_WIDTH = 360;
            const MAX_CONTENT_WIDTH = 4000;

            // 递归收集：默认展开到指定层数的节点 + 当前选中节点的祖先链
            function computeDefaultExpandedKeys(root, targetCurrentId, maxLevel) {
                const ids = [];
                const idSet = new Set();
                const targetId = Number(targetCurrentId) || 0;
                const expandLevel = Number.isFinite(Number(maxLevel)) ? Number(maxLevel) : 1;

                function pushId(id) {
                    if (id == null) return;
                    var n = Number(id); if (!n) return;
                    if (!idSet.has(n)) { idSet.add(n); ids.push(n); }
                }

                function walk(list, level, ancestors) {
                    if (!Array.isArray(list)) return;
                    for (var i = 0; i < list.length; i++) {
                        var n = list[i];
                        if (!n) continue;
                        var nid = Number(n.id) || 0;
                        var lvl = Number(n.treeLevel != null ? n.treeLevel : (n.TreeLevel != null ? n.TreeLevel : level));
                        // TreeLevel 根节点为 0，所以“展开 1 层”应展开 lvl=0 的根节点。
                        if (expandLevel > 0 && lvl >= 0 && lvl < expandLevel) pushId(nid);
                        var nextAnc = ancestors.slice(); nextAnc.push(nid);
                        if (targetId && nid === targetId) {
                            for (var k = 0; k < ancestors.length; k++) pushId(ancestors[k]);
                        }
                        if (Array.isArray(n.children) && n.children.length) walk(n.children, level + 1, nextAnc);
                    }
                }
                walk(root || [], 1, []);
                return ids;
            }

            function getCsrfToken() {
                try {
                    const input = document.querySelector('input[name="__RequestVerificationToken"]');
                    return input ? input.value : '';
                } catch (_) { return ''; }
            }

            // 构建附件页地址。
            function buildAttsUrlLive(menuId, menuName) {
                const mid = Number(menuId) || 0;
                if (!mid) return '';
                const url = new URL('/Shared/Atts', window.location.origin);
                url.searchParams.set('uniId', 'KbMenu-' + mid);
                if (menuName) url.searchParams.set('name', menuName);
                return url.pathname + url.search;
            }

            // 带上 menuId 更新浏览器地址。
            function urlWithMenuId(base, menuId) {
                const u = new URL(base);
                const mid = Number(menuId) || 0;
                if (mid > 0) u.searchParams.set('menuId', String(mid));
                else u.searchParams.delete('menuId');
                return u.toString();
            }

            // 递归查找菜单名称。
            function findMenuNameById(list, targetId) {
                const id = Number(targetId) || 0;
                if (!id || !Array.isArray(list)) return '';
                for (var i = 0; i < list.length; i++) {
                    var node = list[i];
                    if (!node) continue;
                    if (Number(node.id) === id) return node.name || node.label || '';
                    var children = Array.isArray(node.children) ? node.children : [];
                    var name = findMenuNameById(children, id);
                    if (name) return name;
                }
                return '';
            }

            function showMessage(text, type) {
                try {
                    const EP = window.ElementPlus;
                    if (EP && EP.ElMessage) {
                        EP.ElMessage({ message: text || '', type: type || 'info', showClose: true, duration: 2200 });
                        return;
                    }
                } catch (_) {}
                alert(text || '');
            }

            function showConfirm(text, title) {
                try {
                    const EP = window.ElementPlus;
                    if (EP && EP.ElMessageBox) {
                        return EP.ElMessageBox.confirm(text || '确认？', title || '提示', {
                            confirmButtonClass: 'el-button--primary',
                            type: 'warning'
                        }).then(function () { return true; }).catch(function () { return false; });
                    }
                } catch (_) {}
                return Promise.resolve(window.confirm(text || '确认？'));
            }

            const { createApp, ref, onMounted, onBeforeUnmount, computed, watch } = Vue;

            const App = {
                setup() {
                    const treeData = ref(initialTreeData || []);
                    const currentMenuId = ref(initialCurrentId);
                    const treeRef = ref(null);
                    const splitShellRef = ref(null);
                    const isMobileLayout = ref(window.innerWidth < DESKTOP_BREAKPOINT);
                    const asideWidth = ref(DEFAULT_ASIDE_WIDTH);
                    const asideCollapsed = ref(false);
                    const isResizing = ref(false);
                    const lastExpandedAsideWidth = ref(DEFAULT_ASIDE_WIDTH);
                    let _dragMoveHandler = null;
                    let _dragUpHandler = null;
                    let _dragStartX = 0;
                    let _dragStartWidth = 0;

                    // 默认展开：DEFAULT_EXPAND_TREE_LEVEL 指定层级 + 当前选中节点的祖先
                    const defaultExpandedKeys = ref(computeDefaultExpandedKeys(initialTreeData || [], initialCurrentId, DEFAULT_EXPAND_TREE_LEVEL));
                    // 权限：canNew/canEdit/canDelete 都是 JS 字面量 true/false（由上方 @canNew 直接展开）
                    const canNew = canNewFlag;
                    const canEdit = canEditFlag;
                    const canDelete = canDeleteFlag;
                    const canUploadDir = canUploadDirFlag;
                    const hasSelection = computed(function () {
                        return (Number(currentMenuId.value) || 0) > 0;
                    });
                    const currentMenuName = computed(function () {
                        return findMenuNameById(treeData.value || [], currentMenuId.value) || '';
                    });

                    const attsUrl = computed(function () {
                        const mid = currentMenuId.value;
                        if (!mid) return defaultAttsIframeUrl || '';
                        return buildAttsUrlLive(mid, currentMenuName.value);
                    });

                    // 同步 URL 中的 menuId 参数。
                    function switchMenu(nextId, forceReload) {
                        const prev = Number(currentMenuId.value) || 0;
                        const next = Number(nextId) || 0;
                        if (!forceReload && prev === next) return;
                        currentMenuId.value = next;
                        const href = urlWithMenuId(window.location.href, next);
                        if (window.location.href !== href) {
                            window.history.pushState({ menuId: next }, '', href);
                        }
                    }

                    // 按菜单名打开窄屏抽屉。
                    function openMobileAttsDrawer(menuId) {
                        const id = Number(menuId) || 0;
                        if (!id || !isMobileLayout.value) return;
                        const url = buildAttsUrlLive(id, currentMenuName.value || findMenuNameById(treeData.value || [], id));
                        if (!url) return;
                        try {
                            const manager = window.EleManager || window.$eleManager;
                            if (manager && typeof manager.openDrawer === 'function') {
                                if (typeof manager.closeDrawer === 'function') manager.closeDrawer();
                                manager.openDrawer({
                                    title: (currentMenuName.value || '文件列表') + ' - 文件列表',
                                    url: url,
                                    direction: 'rtl',
                                    showFooter: false
                                });
                                return;
                            }
                        } catch (_) {}
                        window.location.href = url;
                    }

                    function onTreeSelect(data) {
                        const id = data && (data.id != null) ? Number(data.id) : 0;
                        switchMenu(id, false);
                        if (id && isMobileLayout.value) openMobileAttsDrawer(id);
                    }

                    // 优先用 EleManager 打开目录表单抽屉。
                    function openDrawerForForm(url, title) {
                        try {
                            const M = window.EleManager || window.$eleManager;
                            if (M && typeof M.openDrawer === 'function') {
                                M.openDrawer({
                                    title: title || '',
                                    url,
                                    showFooter: false,
                                    closeHandler: 'mgr3ReloadPage'
                                });
                                return;
                            }
                        } catch (_) {}
                        // Fallback：新窗口打开
                        try {
                            const w = window.open(url, '_blank', 'noopener,noreferrer');
                            if (w) { w.focus(); return; }
                        } catch (_) {}
                        window.location.href = url;
                    }

                    function onNewMenu() {
                        const selectId = Number(currentMenuId.value) || 0;
                        openDrawerForForm('/KB/MenuForm?id=0&md=new&selectId=' + selectId, '新建知识库目录');
                    }

                    function onEditMenu() {
                        const id = Number(currentMenuId.value) || 0;
                        if (!id) return;
                        openDrawerForForm('/KB/MenuForm?id=' + id + '&md=edit', '编辑知识库目录');
                    }

                    function onOpenUploadDirectory() {
                        const input = document.getElementById('kbDirUploadInput');
                        if (input) input.click();
                    }

                    // 从任意格式的响应数据里提取出最准确的一条错误原因，匹配多种字段名和大小写
                    function extractMessage(data, fallback) {
                        if (!data) return fallback;
                        if (typeof data === 'string') {
                            try {
                                var js = JSON.parse(data);
                                if (js) return extractMessage(js, fallback);
                            } catch (_) {}
                            var s = data.trim();
                            if (s.length > 0 && s.length < 120) return s;
                            return fallback;
                        }
                        if (typeof data !== 'object') return fallback;
                        // 我们的 APIResult 里的字段名组合（各种大小写/别名）
                        var apiNames = ['msg', 'Msg', 'message', 'Message', 'content', 'Content', 'Detail', 'detail', 'Title', 'title'];
                        for (var i = 0; i < apiNames.length; i++) {
                            var k = apiNames[i];
                            if (typeof data[k] === 'string' && data[k].trim().length > 0) return data[k];
                        }
                        // ASP.NET Core ProblemDetails：可能是 errors 对象 + title
                        if (data.errors && typeof data.errors === 'object') {
                            for (var p in data.errors) {
                                if (!Object.prototype.hasOwnProperty.call(data.errors, p)) continue;
                                var list = data.errors[p];
                                if (!list) continue;
                                if (typeof list === 'string' && list.length > 0) return list;
                                if (Array.isArray(list) && list.length > 0) {
                                    for (var j = 0; j < list.length; j++) {
                                        if (typeof list[j] === 'string' && list[j].length > 0) return list[j];
                                    }
                                }
                            }
                        }
                        // BCL 异常对象里 Message
                        if (typeof data.Message === 'string' && data.Message.trim().length > 0) return data.Message;
                        return fallback;
                    }

                    function postHandler(name, payload) {
                        if (!http) {
                            return Promise.resolve({ code: -1, msg: '缺少 axios，无法发起请求' });
                        }
                        const url = new URL(window.location.href);
                        url.searchParams.set('handler', name);
                        return http.post(url.pathname + url.search, payload || {}, {
                            headers: { 'RequestVerificationToken': getCsrfToken() }
                        }).then(function (res) {
                            const body = res && res.data ? res.data : null;
                            if (!body || typeof body !== 'object') {
                                var msg = extractMessage(body, '服务器返回格式异常');
                                return { code: -2, msg: msg };
                            }
                            if (typeof body.code === 'undefined') {
                                if (typeof body.Code !== 'undefined') body.code = body.Code;
                                else if (typeof body.status !== 'undefined') body.code = body.status;
                                else if (typeof body.Status !== 'undefined') body.code = body.Status;
                                else body.code = 0;
                            }
                            if (typeof body.msg === 'undefined') {
                                body.msg = extractMessage(body, '');
                            }
                            return body;
                        }).catch(function (err) {
                            // catch 里不再自行 toast，统一由外层 toastFromResponse 出一条；
                            // 这里解析 err.response.data（可能是 APIResult JSON、ASP.NET ProblemDetails、HTML 错误页字符串或纯文本）
                            var code = -1;
                            var msg = '请求失败';
                            try {
                                if (err && err.response) {
                                    var st = err.response.status;
                                    if (typeof st === 'number') {
                                        msg = '请求异常(' + st + ')';
                                        code = st;
                                    }
                                    var extracted = extractMessage(err.response.data, null);
                                    if (extracted) {
                                        msg = extracted;
                                    } else if (err.response.data && typeof err.response.data === 'string' && err.response.data.length < 120) {
                                        var s2 = err.response.data.trim();
                                        if (s2.length > 0) msg = s2;
                                    }
                                } else if (err && err.message && err.message.length < 120) {
                                    msg = err.message;
                                }
                            } catch (_) {}
                            return { code: code, msg: msg };
                        });
                    }

                    function toastFromResponse(body, fallbackOkMsg) {
                        if (!body || typeof body !== 'object') {
                            showMessage('请求失败', 'error');
                            return;
                        }
                        const d = body.data || {};
                        const errors = Array.isArray(d.errors) ? d.errors.slice() : [];
                        const isPartial = Number(body.code) === 602;
                        if (body.code !== 0 && body.code !== '0' && !isPartial) {
                            showMessage(body.msg || '操作失败', 'error');
                        } else {
                            showMessage(body.msg || (fallbackOkMsg || '操作成功'), isPartial ? 'warning' : 'success');
                        }
                        if (errors.length > 0) {
                            try {
                                const EP = window.ElementPlus || {};
                                const titles = ['上传失败明细'];
                                const first = errors.slice(0, 8);
                                const lines = first.map(function (e, i) {
                                    const name = (e && (e.file || e.fileName) ? (e.file || e.fileName) : '第' + (i + 1) + '个文件');
                                    const reason = (e && e.reason) ? e.reason : '未知错误';
                                    return '· ' + name + '：' + reason;
                                });
                                const text = lines.join('\n') + (errors.length > first.length ? '\n……另有 ' + (errors.length - first.length) + ' 个文件未展示' : '');
                                if (EP.ElMessageBox && EP.ElMessageBox.alert) {
                                    EP.ElMessageBox.alert(text, '失败明细（' + errors.length + '）', {
                                        confirmButtonText: '知道了',
                                        type: 'error',
                                        showClose: true
                                    });
                                } else {
                                    alert('失败明细：\n' + text);
                                }
                            } catch (_) {}
                        }
                    }

                    function applyPostTreeChange(body, lastSelectedId, deleteFlag) {
                        try {
                            const d = body && body.data ? body.data : null;
                            if (d && d.refreshTree && Array.isArray(d.tree)) {
                                treeData.value = d.tree;
                                // 换树后重新计算默认展开层级（新建/删除后结构变了）
                                const next = Number(d.nextMenuId) || 0;
                                defaultExpandedKeys.value = computeDefaultExpandedKeys(d.tree || [], next || currentMenuId.value || 0, DEFAULT_EXPAND_TREE_LEVEL);
                                const deleted = Number(d.deletedId) || 0;
                                if (deleteFlag && deleted && lastSelectedId === deleted) {
                                    switchMenu(0, true);
                                } else if (next && next !== Number(currentMenuId.value)) {
                                    switchMenu(next, false);
                                }
                                return true;
                            }
                            if (d && d.reload) {
                                window.mgr3ReloadPage && window.mgr3ReloadPage();
                                return true;
                            }
                            return false;
                        } catch (e) {
                            console.error('applyPostTreeChange failed:', e);
                            return false;
                        }
                    }

                    function onDeleteMenu() {
                        const id = Number(currentMenuId.value) || 0;
                        if (!id) return;
                        showConfirm('确认删除选中目录？', '提示').then(function (ok) {
                            if (!ok) return;
                            postHandler(HANDLERS.Delete, { id: id }).then(function (body) {
                                toastFromResponse(body, '删除成功');
                                if (!applyPostTreeChange(body, id, true)) {
                                    if (body && (body.code === 0 || body.code === '0') && body.data && body.data.reload) {
                                        window.setTimeout(function () { window.mgr3ReloadPage && window.mgr3ReloadPage(); }, 320);
                                    }
                                }
                            });
                        });
                    }

                    function onMoveUp() {
                        const id = Number(currentMenuId.value) || 0;
                        if (!id) return;
                        postHandler(HANDLERS.MoveUp, { id: id }).then(function (body) {
                            toastFromResponse(body, '上移成功');
                            if (!applyPostTreeChange(body, id, false)) {
                                if (body && (body.code === 0 || body.code === '0') && body.data && body.data.reload) {
                                    window.setTimeout(function () { window.mgr3ReloadPage && window.mgr3ReloadPage(); }, 280);
                                }
                            }
                        });
                    }

                    function onMoveDown() {
                        const id = Number(currentMenuId.value) || 0;
                        if (!id) return;
                        postHandler(HANDLERS.MoveDown, { id: id }).then(function (body) {
                            toastFromResponse(body, '下移成功');
                            if (!applyPostTreeChange(body, id, false)) {
                                if (body && (body.code === 0 || body.code === '0') && body.data && body.data.reload) {
                                    window.setTimeout(function () { window.mgr3ReloadPage && window.mgr3ReloadPage(); }, 280);
                                }
                            }
                        });
                    }

                    function onDirectorySelected(event) {
                        const input = event && event.target ? event.target : null;
                        const files = input && input.files ? Array.from(input.files) : [];
                        if (!files.length) return;

                        files.sort(function (a, b) {
                            const pa = (a.webkitRelativePath || a.name || '').toLowerCase();
                            const pb = (b.webkitRelativePath || b.name || '').toLowerCase();
                            return pa === pb ? 0 : (pa < pb ? -1 : 1);
                        });

                        const formData = new FormData();
                        for (let i = 0; i < files.length; i++) {
                            const file = files[i];
                            formData.append('files', file);
                            formData.append('relativePaths', file.webkitRelativePath || file.name || '');
                        }

                        const url = new URL(window.location.href);
                        url.searchParams.set('handler', HANDLERS.UploadDirectory);
                        const menuId = Number(currentMenuId.value) || 0;
                        if (menuId > 0) url.searchParams.set('menuId', String(menuId));
                        else url.searchParams.delete('menuId');

                        http.post(url.pathname + url.search, formData, {
                            headers: { 'RequestVerificationToken': getCsrfToken() }
                        }).then(function (res) {
                            const body = res && res.data ? res.data : null;
                            toastFromResponse(body, '目录上传成功');
                            if (!applyPostTreeChange(body, menuId, false) && body && (body.code === 0 || body.code === '0')) {
                                window.setTimeout(function () { window.mgr3ReloadPage && window.mgr3ReloadPage(); }, 280);
                            }
                        }).catch(function (err) {
                            const msg = extractMessage(err && err.response ? err.response.data : err, '目录上传失败');
                            showMessage(msg, 'error');
                        }).finally(function () {
                            if (input) input.value = '';
                        });
                    }

                    // 更新响应式状态，并在切换回桌面时关闭可能残留的移动端抽屉。
                    function updateLayoutState() {
                        const mobile = window.innerWidth < DESKTOP_BREAKPOINT;
                        const oldMobile = isMobileLayout.value;
                        isMobileLayout.value = mobile;
                        if (!mobile && oldMobile) {
                            try {
                                const manager = window.EleManager || window.$eleManager;
                                if (manager && typeof manager.closeDrawer === 'function') manager.closeDrawer();
                            } catch (_) {}
                        }
                        if (!mobile) {
                            if (asideCollapsed.value) return;
                            if ((Number(asideWidth.value) || 0) <= 0) {
                                asideWidth.value = lastExpandedAsideWidth.value || DEFAULT_ASIDE_WIDTH;
                            }
                        }
                    }

                    function clampAsideWidthForViewport(widthPx) {
                        const shellEl = (splitShellRef && splitShellRef.value) ? splitShellRef.value : null;
                        const clientW = shellEl && typeof shellEl.clientWidth === 'number'
                            ? shellEl.clientWidth
                            : (typeof window !== 'undefined' ? window.innerWidth : 1280);
                        const barW = 10;
                        const avail = Math.max(MIN_CONTENT_WIDTH + 4, clientW - MIN_CONTENT_WIDTH - barW);
                        const hi = Math.min(MAX_ASIDE_WIDTH, Math.max(MIN_ASIDE_WIDTH, avail));
                        const lo = Math.min(hi, MIN_ASIDE_WIDTH);
                        const size = Number(widthPx);
                        if (!Number.isFinite(size) || size <= 0) return lo;
                        return Math.min(hi, Math.max(lo, Math.round(size)));
                    }

                    function normalizeAsideWidth(value) {
                        const size = Number(value);
                        if (!Number.isFinite(size) || size <= 0) return 0;
                        return clampAsideWidthForViewport(size);
                    }

                    function removeDragListeners() {
                        if (_dragMoveHandler) {
                            try { window.removeEventListener('mousemove', _dragMoveHandler); } catch (_) {}
                            _dragMoveHandler = null;
                        }
                        if (_dragUpHandler) {
                            try { window.removeEventListener('mouseup', _dragUpHandler); } catch (_) {}
                            _dragUpHandler = null;
                        }
                    }

                    function onSplitBarMouseDown(e) {
                        if (!e || typeof e.button !== 'number' || e.button !== 0) return;
                        e.preventDefault && e.preventDefault();
                        e.stopPropagation && e.stopPropagation();
                        if (asideCollapsed.value) {
                            asideCollapsed.value = false;
                            asideWidth.value = lastExpandedAsideWidth.value || DEFAULT_ASIDE_WIDTH;
                            return;
                        }
                        onResizeStart();
                        _dragStartX = Number(e && typeof e.clientX === 'number' ? e.clientX : 0) || 0;
                        _dragStartWidth = Number(asideWidth.value) || MIN_ASIDE_WIDTH;
                        _dragMoveHandler = function (ev) {
                            if (!ev) return;
                            const dx = (Number(ev.clientX) || 0) - _dragStartX;
                            const next = clampAsideWidthForViewport(_dragStartWidth + dx);
                            asideWidth.value = next;
                        };
                        _dragUpHandler = function () {
                            removeDragListeners();
                            onResizeEnd();
                        };
                        window.addEventListener('mousemove', _dragMoveHandler);
                        window.addEventListener('mouseup', _dragUpHandler);
                    }

                    function onToggleCollapse(e) {
                        if (e) {
                            try { e.preventDefault(); e.stopPropagation(); } catch (_) {}
                        }
                        if (asideCollapsed.value) {
                            asideCollapsed.value = false;
                            const restore = lastExpandedAsideWidth.value || DEFAULT_ASIDE_WIDTH;
                            asideWidth.value = clampAsideWidthForViewport(restore);
                            onSplitterCollapse();
                            return;
                        }
                        const current = Number(asideWidth.value) || 0;
                        if (current > 0) {
                            lastExpandedAsideWidth.value = clampAsideWidthForViewport(current);
                        }
                        asideCollapsed.value = true;
                        onSplitterCollapse();
                    }

                    function onResizeStart() {
                        isResizing.value = true;
                        document.body.style.cursor = 'col-resize';
                        document.body.style.userSelect = 'none';
                    }

                    function onResizeEnd() {
                        isResizing.value = false;
                        document.body.style.cursor = '';
                        document.body.style.userSelect = '';
                        const normalized = normalizeAsideWidth(asideWidth.value);
                        if (normalized > 0 && normalized !== Number(asideWidth.value)) {
                            asideWidth.value = normalized;
                        }
                    }

                    function onSplitterCollapse() {
                        window.setTimeout(function () {
                            const size = Number(asideWidth.value) || 0;
                            if (asideCollapsed.value) return;
                            if (size > 0) {
                                lastExpandedAsideWidth.value = normalizeAsideWidth(size) || DEFAULT_ASIDE_WIDTH;
                                return;
                            }
                            asideWidth.value = 0;
                        }, 0);
                    }

                    watch(asideWidth, function (next) {
                        if (asideCollapsed.value) return;
                        const raw = Number(next);
                        if (!Number.isFinite(raw) || raw <= 0) return;
                        const normalized = normalizeAsideWidth(raw);
                        if (normalized !== raw) {
                            asideWidth.value = normalized;
                            return;
                        }
                        lastExpandedAsideWidth.value = normalized;
                    });

                    onMounted(function () {
                        // 启动时根据初始视口对默认 aside 宽度做一次约束，避免右侧内容区 < MIN_CONTENT_WIDTH
                        try {
                            asideWidth.value = clampAsideWidthForViewport(asideWidth.value || DEFAULT_ASIDE_WIDTH);
                        } catch (_) {}
                        updateLayoutState();
                        window.addEventListener('resize', updateLayoutState);

                        // popstate：用户点浏览器前进/后退时，重新同步 currentMenuId 并展开它的祖先
                        window.addEventListener('popstate', function () {
                            try {
                                const u = new URL(window.location.href);
                                const mid = Number(u.searchParams.get('menuId')) || 0;
                                currentMenuId.value = mid;
                                // 如果切换到了新的深层节点，把它的祖先也加入展开 keys（保证可见）
                                if (mid) {
                                    const addIds = computeDefaultExpandedKeys(treeData.value || [], mid, 0) || [];
                                    if (addIds.length) {
                                        var map = new Set(Array.isArray(defaultExpandedKeys.value) ? defaultExpandedKeys.value : []);
                                        var changed = false;
                                        for (var i = 0; i < addIds.length; i++) { if (!map.has(addIds[i])) { map.add(addIds[i]); changed = true; } }
                                        if (changed) defaultExpandedKeys.value = Array.from(map);
                                    }
                                }
                            } catch (_) {}
                        });
                    });

                    onBeforeUnmount(function () {
                        window.removeEventListener('resize', updateLayoutState);
                        removeDragListeners();
                        try {
                            document.body.style.cursor = '';
                            document.body.style.userSelect = '';
                        } catch (_) {}
                    });

                    return {
                        splitShellRef,
                        treeRef,
                        treeData,
                        currentMenuId,
                        asideWidth,
                        asideCollapsed,
                        defaultExpandedKeys,
                        hasSelection,
                        currentMenuName,
                        attsUrl,
                        isMobileLayout,
                        isResizing,
                        canNew,
                        canEdit,
                        canDelete,
                        canUploadDir,
                        MIN_ASIDE_WIDTH,
                        MAX_ASIDE_WIDTH,
                        MIN_CONTENT_WIDTH,
                        MAX_CONTENT_WIDTH,
                        onSplitBarMouseDown,
                        onToggleCollapse,
                        onResizeStart,
                        onResizeEnd,
                        onSplitterCollapse,
                        onTreeSelect,
                        onNewMenu,
                        onOpenUploadDirectory,
                        onDirectorySelected,
                        onEditMenu,
                        onDeleteMenu,
                        onMoveUp,
                        onMoveDown
                    };
                }
            };

            // 全局函数：Drawer 关闭后或保存成功后刷新一次（重新拉取树结构）
            // 同时注册一个 managerReloadPage 别名（兼容可能还残留的老命名）
            window.mgr3ReloadPage = function () {
                try { window.location.reload(); } catch (_) {}
            };
            try { if (typeof window.managerReloadPage === 'undefined') window.managerReloadPage = window.mgr3ReloadPage; } catch (_) {}

            function mountIt() {
                try {
                    const app = createApp(App);
                    const EP = window.ElementPlus;
                    if (EP) {
                        app.use(EP);
                        if (window.dayjs && typeof window.dayjs.locale === 'function') {
                            try { window.dayjs.locale('zh-cn'); } catch (_) {}
                        }
                    }
                    try {
                        const icons = window.ElementPlusIconsVue
                            || (window.ElementPlusIcons ? window.ElementPlusIcons : null)
                            || null;
                        if (icons && typeof icons === 'object') {
                            for (const [k, v] of Object.entries(icons)) {
                                if (v && (typeof v === 'function' || (typeof v === 'object' && v.render))) {
                                    app.component(k, v);
                                }
                            }
                        }
                    } catch (_) {}
                    app.mount('#kbMgr3');
                } catch (err) {
                    console.error('KB Manager3 mount failed:', err);
                }
            }

            function waitAndMount(retry) {
                retry = retry || 0;
                const ok = typeof Vue !== 'undefined'
                    && typeof Vue.createApp === 'function'
                    && window.ElementPlus;
                if (ok) { mountIt(); return; }
                if (retry < 80) { setTimeout(function () { waitAndMount(retry + 1); }, 25); return; }
                console.error('KB Manager3：等待 Vue / ElementPlus 全局加载超时。');
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function () { waitAndMount(0); }, { once: true });
            } else {
                waitAndMount(0);
            }
        })();
    </script>
}
