@page
@model App.Pages.GIS.ApiManagerModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "GIS接口管理中心";
}

@section body {
    <div class="ele-fullscreen-page w-screen h-screen bg-slate-50"
         style="height:100vh;width:100vw;min-height:100vh;min-width:100vw;max-height:100vh;max-width:100vw;overflow:hidden;">
        <div class="flex flex-row h-full w-full overflow-hidden bg-slate-50">
            <aside class="shrink-0 h-full bg-white border-r border-gray-200 overflow-hidden"
                   style="width:300px;min-width:220px;max-width:460px;">
                <div class="h-full flex flex-col bg-white">
                    <div class="flex items-center justify-between px-3 py-2 border-b border-gray-100">
                        <span class="text-sm font-semibold text-gray-700">菜单</span>
                        <EleButton Type="Primary" Look="Circle" Icon="Edit" PopupUrl="Menus" PopupTitle="菜单编辑"></EleButton>
                    </div>
                    <div class="flex-1 min-h-0 overflow-auto bg-white">
                        <EleTree Items="Model.NavMenus"
                                 IdField="Id"
                                 NameField="Name"
                                 ChildrenField="Children"
                                 NodeKey="Id"
                                 HighlightCurrent="true"
                                 DefaultExpandAll="true"
                                 ExpandOnClickNode="false">
                            <template #default="{ data }">
                                <a :href="data.url || '#'" target="gisApiManagerFrame" class="text-current no-underline">{{ data.name }}</a>
                            </template>
                        </EleTree>
                    </div>
                </div>
            </aside>
            <main class="flex-1 h-full w-0 min-w-0 bg-slate-50 overflow-hidden" style="flex:1 1 0%;">
                <iframe name="gisApiManagerFrame"
                        src="@Model.DefaultApisUrl"
                        class="block w-full h-full border-0"
                        frameborder="0"
                        style="width:100%;height:100%;min-width:360px;"></iframe>
            </main>
        </div>
    </div>
    <EleApp />
}
