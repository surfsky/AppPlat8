@page
@model App.Pages.GIS.GeometryImporterModel
@{
    ViewData["Title"] = "GIS点位批量导入";
}

@section body {
    <div id="app" class="h-full flex flex-col p-4 bg-white overflow-hidden">
        <div class="mb-4 rounded border border-slate-200 p-3 bg-slate-50 text-slate-700 text-sm">
            @if (Model.DefaultMenuId.HasValue)
            {
                <div class="mt-1 text-slate-500">导入菜单ID: <span class="font-semibold">@Model.DefaultMenuId.Value</span></div>
            }
            <div class="mt-1 text-slate-500">核心字段：名称、经纬度，其它字段会合并保存到属性字段</div>
        </div>

        <div class="flex flex-wrap gap-3 items-end mb-3">
            <el-button type="primary" @@click="chooseFile">选择Excel文件</el-button>
            <div class="w-[220px]">
                <el-select v-model="coordType" class="w-[220px]" tooltip="请选择源坐标系，系统会自动转换为WGS84" placeholder="请选择源坐标系">
                    <el-option label="WGS84" value="WGS84"></el-option>
                    <el-option label="GCJ-02(火星)" value="GCJ02"></el-option>
                    <el-option label="BD-09(百度)" value="BD09"></el-option>
                </el-select>
            </div>
            <el-button type="success" @@click="startImport" :loading="importing" :disabled="!file">开始导入</el-button>
            <el-button type="text" @@click="downloadTemplate" :loading="downloading">下载模板</el-button>
            <input id="excelFileInput" type="file" accept=".xls,.xlsx" style="display:none" @@change="onFileChange" />
        </div>

        <div class="mb-3 text-sm text-slate-600">
            已选文件: <span class="font-medium">{{ fileName || '未选择文件' }}</span>
        </div>

        <div class="mb-3">
            <el-progress :percentage="progress" :status="progressStatus"></el-progress>
        </div>

        <div class="flex-1 overflow-hidden flex flex-col">
            <div class="text-sm font-medium mb-2">导入日志:</div>
            <div class="flex-1 border border-slate-200 rounded p-2 overflow-y-auto bg-slate-50 font-mono text-xs">
                <div v-for="(log, index) in logs" :key="index" :class="{'text-red-500': log.includes('失败'), 'text-green-600': log.includes('成功')}">
                    {{ log }}
                </div>
                <div v-if="logs.length === 0" class="text-slate-400">等待导入...</div>
            </div>
        </div>
    </div>
}

@section script {
    <script>
        const app = Vue.createApp({
            data() {
                return {
                    file: null,
                    fileName: '',
                    coordType: '@Model.DefaultCoordType',
                    downloading: false,
                    importing: false,
                    progress: 0,
                    progressStatus: '',
                    logs: []
                }
            },
            methods: {
                downloadTemplate() {
                    this.downloading = true;
                    location.href = '@Html.Raw(Model.DefaultMenuId.HasValue ? $"?handler=Template&menuId={Model.DefaultMenuId.Value}" : "?handler=Template")';
                    setTimeout(() => {
                        this.downloading = false;
                    }, 2000);
                },
                chooseFile() {
                    document.getElementById('excelFileInput').click();
                },
                onFileChange(e) {
                    const file = e.target.files[0];
                    if (file) {
                        this.file = file;
                        this.fileName = file.name;
                    }
                },
                async startImport() {
                    if (!this.file) return;

                    this.importing = true;
                    this.progress = 10;
                    this.progressStatus = '';
                    this.logs = ['准备开始导入...'];

                    const formData = new FormData();
                    formData.append('file', this.file);
                    formData.append('coordType', this.coordType || 'WGS84');
                    const postUrl = '@Html.Raw(Model.DefaultMenuId.HasValue ? $"?handler=Import&menuId={Model.DefaultMenuId.Value}" : "?handler=Import")';

                    try {
                        const res = await axios.post(postUrl, formData, {
                            headers: {
                                'Content-Type': 'multipart/form-data',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            onUploadProgress: (progressEvent) => {
                                this.progress = Math.round((progressEvent.loaded * 90) / progressEvent.total);
                            }
                        });

                        const data = res.data;
                        if (data.code === 0) {
                            this.progress = 100;
                            this.progressStatus = 'success';
                            this.logs = data.data.logs || [];
                            this.$message.success(data.msg || '导入成功');
                        } else {
                            this.progressStatus = 'exception';
                            this.logs = (data.data && data.data.logs) ? data.data.logs : [data.msg || '导入失败'];
                            this.$message.error(data.msg || '导入失败');
                        }
                    } catch (err) {
                        this.progressStatus = 'exception';
                        const errMsg = err.response?.data?.msg || err.message || '网络请求错误';
                        this.logs.push('网络请求错误: ' + errMsg);
                        this.$message.error(errMsg);
                    } finally {
                        this.importing = false;
                    }
                }
            }
        });
        app.use(ElementPlus);
        app.mount('#app');
    </script>
}
