@page
@model App.Pages.GIS.MenuFormModel
@{
    ViewData["Title"] = "GIS菜单表单";
    var currentId = Request.Query["id"].ToString();
    var selectedId = Request.Query["selectId"].ToString();
}



@section body {
    <EleForm LabelWidth="120px" Mixins="menuMixin">
        <EleInput For="Item.Name" Label="名称" Required="true"></EleInput>
        <EleTreePicker For="Item.ParentId" Label="上级菜单" Api="/httpapi/gis/GetMenuTree?excludeId=@currentId&amp;selectedId=@selectedId" Clearable="true" CheckStrictly="true"></EleTreePicker>
        <EleImageUpload For="Item.Icon" Label="图标" FillRow="true" ItemWidth="64"></EleImageUpload>
        <EleSwitch For="Item.IsDefaultShow" Label="默认显示"></EleSwitch>
        <EleNumber For="Item.Zoom" Label="显示级别" Min="0" Max="24" Step="0.1"></EleNumber>
        <EleSwitch For="Item.Selectable" Label="是否可选"></EleSwitch>
        <EleNumber For="Item.SortId" Label="排序" Min="0" Max="100000"></EleNumber>
        <EleSelect For="Item.DataFrom" Label="数据来源"></EleSelect>
        <div v-show="Number(form.dataFrom ?? 0) === 2 || String(form.dataFrom ?? '').toLowerCase() === 'api'">
            <EleInput For="Item.DataUrl" Label="数据地址" FillRow="true" Placeholder="如: /httpapi/gis/getcheckobjects?tagnames=危化品">
                <template #append>
                    <el-button class="menu-dataurl-test-btn" link type="primary" @@click="testApiUrl(form.dataUrl)" title="测试">
                        <i class="fa-solid fa-flask-vial"></i>
                    </el-button>
                </template>
            </EleInput>
        </div>
        <div v-show="Number(form.dataFrom ?? 0) === 2 || String(form.dataFrom ?? '').toLowerCase() === 'api'">
            <EleInput For="Item.ItemUrl" Label="详情地址" FillRow="true" Placeholder="如: Checks/CheckObjectForm?id={0}"></EleInput>
        </div>
        <EleNumber For="Item.DataCnt" Label="点位数" Min="0" Max="10000000"></EleNumber>
        <EleDatePicker For="Item.DataDt" Label="最后数据时间" Type="DateTime"></EleDatePicker>

        <Bottom>
            <EleButton Type="Primary" Command="SaveClose"  Icon="Check"Visible="@(Model.Mode != PageMode.View)">保存</EleButton>
            <EleButton Type="Primary" Command="SaveNew" Visible="@(Model.Mode != PageMode.View)">保存并新增</EleButton>
            <EleButton Command="Close" Icon="Close">关闭</EleButton>
        </Bottom>
    </EleForm>
}

@section script{
    <script>
        const menuMixin = {
            methods: {
                async testApiUrl(url) {
                    if (!url || !String(url).trim()) {
                        EleManager.showWarning('请先填写数据地址');
                        return;
                    }
                    try {
                        const fullUrl = /^https?:\/\//i.test(url) ? url : window.location.origin + url;
                        const resp = await fetch(fullUrl, { credentials: 'same-origin' });
                        const json = await resp.json();
                        const data = json?.data ?? json;
                        const cnt = Array.isArray(data) ? data.length : (data ? 1 : 0);
                        if (this.form) {
                            if ('dataCnt' in this.form) this.form.dataCnt = cnt;
                            if ('dataDt' in this.form) this.form.dataDt = new Date().toISOString().replace('T', ' ').slice(0, 19);
                        }
                        EleManager.showSuccess(`测试成功，共 ${cnt} 条数据`);
                    } catch (e) {
                        EleManager.showError(`测试失败: ${e?.message || e}`);
                    }
                }
            }
        };
    </script>
}
