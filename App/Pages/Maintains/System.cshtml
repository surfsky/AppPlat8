@page
@model App.Pages.SystemModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "系统状态";
}

@section body {
<div class="w-full max-w-6xl mx-auto px-4 py-6 md:px-6 lg:px-10 text-slate-700">

    <!-- 顶部操作栏 -->
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                <i class="fas fa-gauge-high text-lg"></i>
            </div>
            <div>
                <h1 class="text-xl md:text-2xl font-bold text-slate-800">系统状态</h1>
                <p class="text-xs text-slate-500 mt-0.5">运行环境与资源占用实时信息</p>
            </div>
        </div>
        <a asp-page="/System" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-sky-50 text-sky-600 hover:bg-sky-100 transition text-sm font-medium border border-sky-100">
            <i class="fas fa-arrows-rotate"></i>
            <span>刷新</span>
        </a>
    </div>

    <!-- 系统信息卡片 -->
    <section class="rounded-2xl bg-white shadow-sm border border-slate-200/70 p-6 md:p-8">
        <dl class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 text-xs md:text-sm">
            <div class="rounded-xl bg-slate-50 border border-slate-100 px-4 py-3">
                <dt class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-tag text-[11px] text-slate-400"></i>当前版本</dt>
                <dd class="mt-1 font-semibold text-slate-800">@Model.ProductVersion</dd>
            </div>
            <div class="rounded-xl bg-slate-50 border border-slate-100 px-4 py-3">
                <dt class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-microchip text-[11px] text-slate-400"></i>运行时</dt>
                <dd class="mt-1 font-semibold text-slate-800">@Model.RuntimeVersion</dd>
            </div>
            <div class="rounded-xl bg-slate-50 border border-slate-100 px-4 py-3">
                <dt class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-server text-[11px] text-slate-400"></i>操作系统</dt>
                <dd class="mt-1 font-semibold text-slate-800 truncate" title="@Model.OperatingSystem">@Model.OperatingSystem</dd>
            </div>
            <div class="rounded-xl bg-slate-50 border border-slate-100 px-4 py-3">
                <dt class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-layer-group text-[11px] text-slate-400"></i>进程架构</dt>
                <dd class="mt-1 font-semibold text-slate-800">@Model.ProcessArchitecture</dd>
            </div>
            <div class="rounded-xl bg-slate-50 border border-slate-100 px-4 py-3">
                <dt class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-calendar-check text-[11px] text-slate-400"></i>构建时间</dt>
                <dd class="mt-1 font-semibold text-slate-800">@Model.BuildTime</dd>
            </div>
            <div class="rounded-xl bg-slate-50 border border-slate-100 px-4 py-3">
                <dt class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-play text-[11px] text-emerald-500"></i>启动时间</dt>
                <dd class="mt-1 font-semibold text-slate-800">@Model.AppStartedAt</dd>
            </div>
            <div class="rounded-xl bg-slate-50 border border-slate-100 px-4 py-3">
                <dt class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-stopwatch text-[11px] text-blue-500"></i>已运行</dt>
                <dd class="mt-1 font-semibold text-slate-800" title="精确毫秒：@Model.StartupDurationMs">@Model.UptimeText</dd>
            </div>
            <div class="rounded-xl bg-slate-50 border border-slate-100 px-4 py-3">
                <dt class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-microchip text-[11px] text-orange-500"></i>CPU 使用率</dt>
                <dd class="mt-1 font-semibold text-slate-800">@Model.CpuUsageText</dd>
            </div>
            <div class="rounded-xl bg-slate-50 border border-slate-100 px-4 py-3">
                <dt class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-memory text-[11px] text-indigo-500"></i>内存使用 / 总量</dt>
                <dd class="mt-1 font-semibold text-slate-800">@Model.MemoryUsedText</dd>
            </div>
            <div class="rounded-xl bg-slate-50 border border-slate-100 px-4 py-3">
                <dt class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-hard-drive text-[11px] text-rose-500"></i>磁盘使用 / 总量</dt>
                <dd class="mt-1 font-semibold text-slate-800">@Model.DiskUsedText</dd>
            </div>
        </dl>
    </section>
</div>
}
