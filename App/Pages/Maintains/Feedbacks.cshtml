@page
@model App.Pages.Maintains.FeedbacksModel
@{
    ViewData["Title"] = "反馈建议";
}

@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="反馈" FormPage="FeedbackForm" EnableBatch="true">
        <Toolbar>
            <Filters>
                <EleInput For="Item.User" Label="提交人" Width="160px"></EleInput>
                <EleInput For="Item.Content" Label="关键词" Width="220px"></EleInput>
                <EleSelect For="Item.Type" Label="类型" Width="140px" Clearable="true"></EleSelect>
                <EleSelect For="Item.Status" Label="状态" Width="140px" Clearable="true"></EleSelect>
                <EleSelect For="Item.App" Label="系统" Width="140px" Clearable="true"></EleSelect>
                <EleDatePicker For="Item.CreateDt" Label="起始时间" Width="180px"></EleDatePicker>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" Command="Add" Icon="Plus" Visible="@Auth.CheckPower(Power.FeedBackNew)">新增</EleButton>
                <EleButton Type="Danger" Command="BatchDelete" Icon="Delete" Visible="@Auth.CheckPower(Power.FeedBackDelete)">删除</EleButton>
            </Buttons>
        </Toolbar>

        <Columns>
            <EleNumColumn></EleNumColumn>
            <EleColumn For="Item.Title" Label="概述" Link="true" MinWidth="220"></EleColumn>
            <EleColumn For="Item.TypeName" Label="类型" Width="100"></EleColumn>
            <EleColumn For="Item.StatusName" Label="状态" Width="100"></EleColumn>
            <EleColumn For="Item.AppName" Label="系统" Width="120"></EleColumn>
            <EleColumn For="Item.User" Label="提交人" Width="120"></EleColumn>
            <EleColumn For="Item.Contacts" Label="联系方式" Width="140"></EleColumn>
            <EleColumn For="Item.Content" Label="信息" MinWidth="260" ShowOverflowTooltip="true"></EleColumn>
            <EleColumn For="Item.Reply" Label="回应" MinWidth="220" ShowOverflowTooltip="true"></EleColumn>
            <EleColumn For="Item.CreateDt" Label="创建时间" Width="170" FormatString="yyyy-MM-dd HH:mm"></EleColumn>
            <EleOpColumn Width="100" Fixed="right">
                <Op Command="Edit" Icon="Edit" Tooltip="编辑" Visible="@Auth.CheckPower(Power.FeedBackEdit)"></Op>
                <Op Command="Delete" Icon="Delete" Tooltip="删除" Visible="@Auth.CheckPower(Power.FeedBackDelete)"></Op>
            </EleOpColumn>
        </Columns>
    </EleTable>
}
