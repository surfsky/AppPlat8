@page
@model App.Pages.Maintains.IPFilterFormModel
@{
    ViewData["Title"] = "IP过滤";
}

@section body {
    <EleForm LabelWidth="120px">
        <EleInput For="Item.IP" Label="IP地址" Required="true"></EleInput>
        <EleInput For="Item.StartDt" Label="开始时间" Required="true"></EleInput>
        <EleInput For="Item.EndDt" Label="结束时间" Required="true"></EleInput>
        <EleInput For="Item.Remark" Label="备注"></EleInput>

        <Bottom>
            <EleButton Type="Primary" Command="SaveClose" Visible="@(Model.Mode != PageMode.View)">保存</EleButton>
            <EleButton Command="Close">关闭</EleButton>
        </Bottom>
    </EleForm>
}
