@page
@model App.Pages.Maintains.IPFiltersModel
@{
    ViewData["Title"] = "反馈建议";
}

@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="IP 黑名单" FormPage="IPFiltersForm" EnableBatch="true">
        <Toolbar>
            <Filters>
                <EleInput For="Item.IP" Label="IP" Width="160px"></EleInput>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" Command="Add" Icon="Plus" Visible="@Auth.CheckPower(Power.Admin)">新增</EleButton>
                <EleButton Type="Danger" Command="DeleteBatch" Icon="Delete" Visible="@Auth.CheckPower(Power.Admin)">删除</EleButton>
            </Buttons>
        </Toolbar>

        <Columns>
            <EleNumColumn></EleNumColumn>
            <EleColumn For="Item.IP" Label="IP" Width="160"></EleColumn>
            <EleColumn For="Item.StartDt" Label="开始时间" Width="170" FormatString="yyyy-MM-dd HH:mm"></EleColumn>
            <EleColumn For="Item.EndDt" Label="结束时间" Width="170" FormatString="yyyy-MM-dd HH:mm"></EleColumn>
            <EleColumn For="Item.Remark" Label="备注" Width="200"></EleColumn>
            <EleColumn For="Item.CreateDt" Label="创建时间" Width="170" FormatString="yyyy-MM-dd HH:mm"></EleColumn>
            <EleOpColumn Width="100" Fixed="right">
                <Op Command="Edit" Icon="Edit" Tooltip="编辑" Visible="@Auth.CheckPower(Power.FeedBackEdit)"></Op>
                <Op Command="Delete" Icon="Delete" Tooltip="删除" Visible="@Auth.CheckPower(Power.FeedBackDelete)"></Op>
            </EleOpColumn>
        </Columns>
    </EleTable>
}
