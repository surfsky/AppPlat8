@page
@model App.Pages.Maintains.SiteConfigFormModel
@{
    ViewData["Title"] = "站点配置";
}

@section body {
    <EleForm LabelWidth="140px">
        <EleLabel Label="UI" FillRow="true"></EleLabel>
        <EleImageUpload For="Item.Icon"    Label="网站图标"  FillRow="true" ItemWidth="64" ></EleImageUpload>
        <EleImageUpload For="Item.LoginBg" Label="登录页背景" FillRow="true" ></EleImageUpload>

        <EleLabel Label="基础" FillRow="true"></EleLabel>
        <EleInput For="Item.Title" Label="网站标题" Required="true"></EleInput>
        <EleInput For="Item.BeiAnNo" Label="备案号"></EleInput>
        <EleInput For="Item.Terms" Label="服务条款" Rows="10" FillRow="true" watermark="请输入服务条款（支持HTML）"></EleInput>

        <EleLabel Label="数据" FillRow="true"></EleLabel>
        <EleInput For="Item.DefaultPassword" Label="默认密码"></EleInput>
        <EleSelect For="Item.PageSize" Label="分页大小" Items="new []{10,20,50,100}"></EleSelect>
        <EleNumber For="Item.UpFileSize" Label="上传大小限制" Append="MB"></EleNumber>
        <EleInput For="Item.UpFileTypes" Label="上传文件类型" Type="TextArea" Rows="3" FillRow="true"></EleInput>
    

        <EleLabel Label="驾驶舱" FillRow="true"></EleLabel>
        <EleInput For="Item.GisTitle" Label="驾驶舱标题" Placeholder="例如：数据驾驶舱"></EleInput>
        <EleInput For="Item.MapboxKey" Label="MapBox Key"></EleInput>
        <EleInput For="Item.TiandituKey" Label="天地图 Key"></EleInput>


        <EleLabel Label="安全" FillRow="true"></EleLabel>
        <EleInput For="Item.PrivateKey" Label="私钥" Type="TextArea" Rows="3" FillRow="true" watermark="请输入私钥（支持HTML）"></EleInput>
        <EleInput For="Item.PublicKey" Label="公钥" Type="TextArea" Rows="3" FillRow="true" watermark="请输入公钥（支持HTML）"></EleInput>
        <EleCheckbox For="Item.EnableLoginAI" Label="是否启用 /LoginAI（默认仅 Development 环境启用，设为 false 可强制关闭）"></EleCheckbox>

        <Bottom>
            <EleButton Type="Primary" Command="Save">保存</EleButton>
        </Bottom>
    </EleForm>
}
