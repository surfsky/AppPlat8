@page
@model App.Pages.Events.EventsModel
@{
    ViewData["Title"] = "工作动态管理";
}

@section body {
                <EleButton Type="Default" Look="Circle" Icon="Opportunity" FixPosition="TopRight" PopupText="https://www.baidu.com"></EleButton>

    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="工作动态" FormPage="EventForm" EnableBatch="true" SortField="HappenDt" SortOrder="desc" >
        <Toolbar>
            <Filters>
                <EleTreePicker For="Item.TypeId" Width="150px" Label="类别" LabelWidth="60px" Items="Model.EventTypes" Clearable="true"></EleTreePicker>
                <EleInput For="Item.Title" Width="200px" Label="标题" LabelWidth="60px"></EleInput>
                <EleTreePicker For="Item.OrgId" Width="300px" Label="所属网格" Multiple="false" CollapseTags="false" 
                               Api="/httpapi/orgs/GetAuthOrgTree" ExpandLevel="3" ShowAllButton="true"></EleTreePicker>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" Command="Add" Icon="Plus">新增</EleButton>
                <EleButton Type="Danger" Command="DeleteBatch" Icon="Delete">删除</EleButton>
                <EleButton Type="Success" PopupUrl="EventTypes" PopupTitle="事件类别" Icon="Setting" Visible="@Auth.HasPower(Power.EventTypeEdit)">类别管理</EleButton>
                <EleRefreshSwitch Interval="30" Triggle="Data" />
            </Buttons>
        </Toolbar>
        <Columns>
            <EleNumColumn></EleNumColumn>
            <EleOpColumn Width="100" Fixed="right">
                <Op Command="Edit"   Icon="Edit" Tooltip="编辑" Visible="@Auth.HasPower(Power.EventEdit)"></Op>
                <Op Command="Delete" Icon="Delete" Tooltip="删除" Visible="@Auth.HasPower(Power.EventDelete)"></Op>
            </EleOpColumn>
            <EleColumn For="Item.Title" Label="标题" Link="true" MinWidth="200" Sortable="true"></EleColumn>
            <EleColumn For="Item.TypeName" Label="类别" Width="100"></EleColumn>
            <EleColumn For="Item.HappenDt" Label="时间" Width="200" FormatString="yyyy-MM-dd HH:mm"></EleColumn>
            <EleColumn For="Item.OrgName" Label="组织" Width="120"></EleColumn>
            <EleColumn For="Item.PublisherName" Label="发布人" Width="100"></EleColumn>
            <EleColumn For="Item.AllowComment" Label="允许评论" Width="80" Visible="false"></EleColumn>
            <EleColumn For="Item.Gps" Label="经纬度" Width="120"></EleColumn>
        </Columns>
    </EleTable>
}
