@page
@model App.Pages.Events.EventFormModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "工作动态";
}

@section body {
    <EleForm LabelWidth="120px">
        <EleImageUpload For="Item.MainImage" Label="主图" FillRow="true"></EleImageUpload>
        <EleInput For="Item.Title" Label="标题" Required="true" FillRow="true"></EleInput>
        <EleTreePicker For="Item.TypeId" Label="类别" Items="Model.EventTypes" Required="true"></EleTreePicker>
        <EleDatePicker For="Item.HappenDt" Label="时间" Type="@EleDatePickerType.DateTime" Required="true"></EleDatePicker>
        <EleTreePicker For="Item.OrgId" Label="组织" Api="/httpapi/orgs/GetAuthOrgTree"  CheckStrictly="true" Required="true"></EleTreePicker>
        <EleSwitch For="Item.AllowComment" Label="允许评论" Visible="false"></EleSwitch>
        <ElePicker For="Item.Gps" TextFor="Item.Gps" Label="地图定位" PopupUrl="/GIS/Locator" Icon="Location"></ElePicker>
        <EleInput For="Item.Content" Label="内容" Rows="5" FillRow></EleInput>
    
        <Bottom>
            <EleButton Type="Primary" Command="SaveClose" Icon="Check" Visible="@(Model.Mode != PageMode.View)">保存</EleButton>
            <EleButton Command="Close" Icon="Close">关闭</EleButton>
        </Bottom>
    </EleForm>
}