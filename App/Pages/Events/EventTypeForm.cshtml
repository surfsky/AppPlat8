@page
@model App.Pages.Events.EventTypeFormModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "事件类别信息";
}

@section body {
    <EleForm Model="form" LabelWidth="120px">
        <EleInput For="Item.Name" Label="名称" Required="true"></EleInput>
        <EleTreePicker For="Item.ParentId" Label="上级类别" Items="Model.TypeTree" Clearable="true"></EleTreePicker>
        <EleNumber For="Item.SortId" Label="排序" Min="0" Max="100000"></EleNumber>
    
        <Bottom>
            <EleButton Type="Primary" Command="SaveClose"  Icon="Check"Visible="@(Model.Mode != PageMode.View)">保存</EleButton>
            <EleButton Command="Close" Icon="Close">关闭</EleButton>
        </Bottom>
    </EleForm>
}
