@page
@model App.Pages.Shared.ImportorModel
@{
    ViewData["Title"] = "Excel导入";
    var typeName = Model.Type ?? string.Empty;
    var columnMode = Model.ColumnMode ?? "Title";
    var templateId = Model.TemplateId?.ToString() ?? string.Empty;
    var ignoreId = Model.IgnoreId ? "true" : "false";
    var typeTitle = string.IsNullOrWhiteSpace(Model.TypeTitle) ? typeName : Model.TypeTitle;
}

@section body {
    <div id="app" class="h-full flex flex-col p-4 bg-white overflow-hidden">
        <div class="mb-4 rounded border border-slate-200 p-3 bg-slate-50 text-slate-700 text-sm">
            <div>导入类型: <span class="font-semibold">@typeTitle</span></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.KeyField))
        {
            <div class="mb-3 rounded border border-blue-200 bg-blue-50 px-3 py-2 text-sm text-blue-700">
                匹配字段: <span class="font-semibold">@Model.KeyField</span>
                <span class="text-blue-500">（已存在则更新，不存在则新增；Excel 中未出现的列不会被覆盖）</span>
            </div>
        }

        @if (Model.Lenient)
        {
            <div class="mb-3 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-700">
                宽松模式: 无法识别的单元格会被置空并提示，该行仍然导入。
            </div>
        }

        <div class="flex flex-wrap gap-2 mb-3">
            <el-button @@click="downloadTemplate" :loading="downloading" icon="Download">下载模板</el-button>
            <el-button type="primary" @@click="chooseFile" icon="DocumentAdd">选择Excel文件</el-button>
            <el-button type="success" @@click="startImport" :loading="importing" :disabled="!file" icon="Upload">开始导入</el-button>
            <input id="excelFileInput" type="file" accept=".xls,.xlsx" style="display:none" @@change="onFileChange" />
        </div>

        <div class="mb-3 text-sm text-slate-600">
            已选文件: <span class="font-medium">{{ fileName || '未选择文件' }}</span>
        </div>

        <div class="mb-3">
            <el-progress :percentage="progress" :status="progressStatus"></el-progress>
        </div>

        <!-- 日志区：占满底部剩余空间 -->
        <div class="flex-1 min-h-[160px] flex flex-col rounded border border-slate-200 overflow-hidden">
            <div class="flex-none flex items-center justify-between px-3 py-1.5 bg-slate-50 border-b border-slate-200">
                <span class="text-xs text-slate-500">导入日志</span>
                <div class="flex items-center">
                    <el-button link size="small" @@click="copyLogs" icon="DocumentCopy">复制</el-button>
                    <el-button link size="small" @@click="clearLogs" icon="Delete">清空</el-button>
                </div>
            </div>
            <div ref="logsBox" class="flex-1 min-h-0 overflow-auto bg-white px-3 py-2 font-mono text-xs leading-5 text-slate-700 whitespace-pre-wrap break-words">{{ logsText }}</div>
        </div>
    </div>
}

@section script {
    <script>
        const { createApp, ref, watch, nextTick } = Vue;

        const app = createApp({
            setup() {
                const typeName = '@typeName';
                const columnMode = '@columnMode';
                const templateId = '@templateId';
                const ignoreId = '@ignoreId';
                const file = ref(null);
                const fileName = ref('');
                const importing = ref(false);
                const downloading = ref(false);
                const progress = ref(0);
                const progressStatus = ref('');
                const logsText = ref('');
                const logsBox = ref(null);

                // 日志变化时自动滚动到底部
                const scrollLogsToBottom = () => {
                    nextTick(() => {
                        const el = logsBox.value;
                        if (el) el.scrollTop = el.scrollHeight;
                    });
                };
                watch(logsText, scrollLogsToBottom);

                const clearLogs = () => {
                    logsText.value = '';
                };

                const copyLogs = async () => {
                    const text = logsText.value || '';
                    if (!text) {
                        EleManager?.showWarning?.('暂无日志可复制');
                        return;
                    }
                    try {
                        if (navigator.clipboard?.writeText) {
                            await navigator.clipboard.writeText(text);
                        } else {
                            const ta = document.createElement('textarea');
                            ta.value = text;
                            ta.style.position = 'fixed';
                            ta.style.opacity = '0';
                            document.body.appendChild(ta);
                            ta.select();
                            document.execCommand('copy');
                            document.body.removeChild(ta);
                        }
                        EleManager?.showSuccess?.('日志已复制');
                    } catch (e) {
                        EleManager?.showError?.('复制失败，请手动选择文本复制');
                    }
                };

                const appendServerLogs = (body) => {
                    const logs = body && body.data && Array.isArray(body.data.logs) ? body.data.logs : [];
                    logs.forEach(appendLog);
                };

                const appendLog = (text) => {
                    if (!text) return;
                    const line = `[${new Date().toLocaleTimeString()}] ${text}`;
                    logsText.value = logsText.value ? `${logsText.value}\n${line}` : line;
                };

                const chooseFile = () => {
                    const input = document.getElementById('excelFileInput');
                    if (input) input.click();
                };

                const onFileChange = (evt) => {
                    const input = evt.target;
                    const f = input && input.files && input.files.length > 0 ? input.files[0] : null;
                    file.value = f;
                    fileName.value = f ? f.name : '';
                    if (f) appendLog(`已选择文件: ${f.name}`);
                };

                const downloadTemplate = () => {
                    downloading.value = true;
                    try {
                        appendLog('开始下载模板...');
                        const tid = templateId ? `&templateId=${encodeURIComponent(templateId)}` : '';
                        const url = `?handler=Template&type=${encodeURIComponent(typeName)}&columnMode=${encodeURIComponent(columnMode)}&ignoreId=${encodeURIComponent(ignoreId)}${tid}`;
                        const a = document.createElement('a');
                        a.href = url;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        appendLog('模板下载请求已发送');
                    } finally {
                        downloading.value = false;
                    }
                };

                const startImport = async () => {
                    if (!file.value) {
                        EleManager.showWarning('请先选择Excel文件');
                        return;
                    }

                    importing.value = true;
                    progress.value = 8;
                    progressStatus.value = '';
                    appendLog('开始上传并导入...');

                    try {
                        const formData = new FormData();
                        formData.append('file', file.value);

                        // 保留当前页面 URL 中的业务参数（如 checkObjectId），一并传递给导入接口
                        const preservedParams = new URLSearchParams(window.location.search);
                        ['handler', 'columnMode', 'ignoreId', 'templateId', 'id', 'md'].forEach(k => preservedParams.delete(k));
                        const importUrl = `?handler=Import&${preservedParams.toString()}`;

                        const res = await axios.post(importUrl, formData, {
                            headers: {
                                'RequestVerificationToken': (window.Utils && Utils.getCsrfToken) ? Utils.getCsrfToken() : ''
                            }
                        });

                        progress.value = 85;
                        const body = res && res.data ? res.data : null;
                        if (!body || (body.code !== 0 && body.code !== '0')) {
                            progress.value = 100;
                            progressStatus.value = 'exception';
                            appendServerLogs(body);
                            appendLog((body && (body.msg || body.info)) || '导入失败');
                            EleManager.showError((body && (body.msg || body.info)) || '导入失败');
                            return;
                        }

                        const data = body.data || {};
                        const logs = Array.isArray(data.logs) ? data.logs : [];
                        logs.forEach(appendLog);

                        progress.value = 100;
                        progressStatus.value = data.fail > 0 ? 'warning' : 'success';
                        EleManager.showSuccess(body.msg || '导入完成');
                    } catch (e) {
                        progress.value = 100;
                        progressStatus.value = 'exception';
                        appendServerLogs(e?.response?.data);
                        const msg = e?.response?.data?.msg || e?.response?.data?.info || e?.message || '导入失败';
                        appendLog(msg);
                        EleManager.showError(msg);
                    } finally {
                        importing.value = false;
                    }
                };

                return {
                    file,
                    fileName,
                    importing,
                    downloading,
                    progress,
                    progressStatus,
                    logsText,
                    logsBox,
                    chooseFile,
                    onFileChange,
                    downloadTemplate,
                    startImport,
                    copyLogs,
                    clearLogs
                };
            }
        })
        .use(ElementPlus, { locale: ElementPlusLocaleZhCn });
        // 注册 Element Plus 图标组件，使 el-button icon="Download" 等字符串名能生效
        for (const [key, component] of Object.entries(window.ElementPlusIconsVue || {})) {
            app.component(key, component);
        }
        app.mount('#app');
    </script>
}
