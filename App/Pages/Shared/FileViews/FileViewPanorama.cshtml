@page "/Shared/FileViews/Panorama"
@using System.Text.Json
@{
    Layout = null;
    var preview = App.Pages.Shared.FileViews.FilePreviewResolver.Resolve(
        Request.Query["id"].ToString(),
        Request.Query["src"].ToString(),
        Request.Query["name"].ToString());
    var srcJson = JsonSerializer.Serialize(preview.SourceUrl ?? string.Empty);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css" />
    <style>
        html, body { margin: 0; height: 100%; background: #020617; }
        #pano { width: 100%; height: 100%; }
    </style>
</head>
<body>
    <div id="pano"></div>
    <script>
        const src = @Html.Raw(srcJson);
        pannellum.viewer('pano', {
            type: 'equirectangular',
            panorama: src,
            autoLoad: true,
            showControls: true,
            compass: false
        });
    </script>
</body>
</html>
