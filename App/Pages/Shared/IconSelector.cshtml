@page
@using Microsoft.AspNetCore.Mvc.RazorPages
@functions {
    public class IconSelectorModel : PageModel
    {
        public void OnGet() { }
    }
}
@model IconSelectorModel
@{
    Layout = "_Layout";
}

@section head {
    <style>
        .icon-item {
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
        }
        .icon-item:hover {
            background-color: #f3f4f6;
            transform: scale(1.1);
        }
        .icon-item.is-selected {
            background-color: #eff6ff;
            border-color: #2563eb !important;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.25), 0 4px 10px -2px rgba(37, 99, 235, 0.25);
            transform: translateY(-1px) scale(1.03);
        }
        .icon-item.is-selected::after {
            content: "✓";
            position: absolute;
            top: 6px;
            right: 8px;
            width: 18px;
            height: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background-color: #2563eb;
            color: #fff;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 700;
            line-height: 1;
            box-shadow: 0 2px 4px rgba(37, 99, 235, 0.4);
        }
        .icon-item.is-selected i {
            color: #2563eb !important;
        }
        .icon-item.is-selected span {
            color: #1d4ed8 !important;
            font-weight: 600;
        }
    </style>
}

@section body {
    <div class="p-4 bg-white w-full h-full overflow-y-auto">
        <div class="mb-4">
            <input type="text" id="searchInput" placeholder="搜索图标..." class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div class="grid grid-cols-6 gap-4" id="iconGrid">
            <!-- Icons will be populated here -->
        </div>
    </div>
}

