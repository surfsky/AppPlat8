            { cls: "far fa-object-group", label: "object-group (线框)" },
            { cls: "far fa-object-ungroup", label: "object-ungroup (线框)" }
        ];

        const grid = document.getElementById('iconGrid');
        const searchInput = document.getElementById('searchInput');

        /** 从 URL 中解析当前已选的图标 class。
         *  传入的参数可能叫 pickerValue / data / imageUrl / geojson，并且值可能被重复 URL 编码、
         *  或是 "fas fa-file-alt" 这种带空格的形式，所以：
         *  1) 按优先级取：pickerValue > data > imageUrl > geojson > 第一个非空值；
         *  2) 每个参数在解码后做 trim；空值跳过。
         */
        function readSelectedFromUrl() {
            try {
                const params = new URL(window.location.href).searchParams;
                const candidateKeys = ['pickerValue', 'data', 'imageUrl', 'geojson'];
                const decoded = [];
                params.forEach(function (value, key) {
                    if (candidateKeys.indexOf(key) < 0) return;
                    var raw = params.get(key);
                    if (raw == null) return;
                    var s = String(raw).trim();
                    if (s) decoded.push({ k: key, v: s });
                    try {
                        var s2 = decodeURIComponent(raw);
                        if (s2 && s2 !== s) decoded.push({ k: key, v: String(s2).trim() });
                    } catch (_) { /* ignore malformed */ }
                });
                for (var i = 0; i < candidateKeys.length; i++) {
                    var key = candidateKeys[i];
                    var found = decoded.find(function (x) { return x.k === key && x.v; });
                    if (found) return found.v;
                }
                return decoded.length ? decoded[0].v : '';
            } catch (_) {
                return '';
            }
        }

        const selectedIconCls = readSelectedFromUrl();

        /** 渲染图标网格：按 cls + label 两个字段做模糊搜索；选中的图标项加 is-selected + 右上角 ✓ */
        function renderIcons(filter, options) {
            grid.innerHTML = '';
            const q = String(filter || '').trim().toLowerCase();
            const selected = String(options && options.selected ? options.selected : selectedIconCls || '').trim();
            const selectedNode = (selected && selected.toLowerCase()) || '';
            var selectedEl = null;
            icons.forEach(function (icon) {
                const searchable = ((icon.cls || '') + ' ' + (icon.label || icon.cls || '')).toLowerCase();
                if (q && searchable.indexOf(q) < 0) return;

                const iconCls = String(icon.cls || '').trim();
                if (!iconCls) return;
                const display = icon.label || iconCls;
                const div = document.createElement('div');
                const isMatch = selected && (
                    iconCls === selected ||
                    iconCls.toLowerCase() === selectedNode
                );
                div.className =
                    'icon-item flex flex-col items-center justify-center p-3 border border-gray-100 rounded hover:shadow-sm' +
                    (isMatch ? ' is-selected' : '');
                div.setAttribute('data-icon-cls', iconCls);
                div.innerHTML =
                    '<i class="' + iconCls + ' text-2xl text-gray-600 mb-2"></i>' +
                    '<span class="text-xs text-gray-500 truncate w-full text-center" title="' + iconCls + '">' + display + '</span>';
                div.onclick = function () { selectIcon(iconCls); };
                grid.appendChild(div);
                if (isMatch && !selectedEl) selectedEl = div;
            });
            if (selectedEl && (options && options.scrollIntoView) !== false) {
                try {
                    selectedEl.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'nearest' });
                } catch (_) { /* old browsers ignore */ }
            }
        }

        /** 选择图标：完整 class 作为返回值（直接返回 icon.cls） */
        function selectIcon(iconCls) {
            const data = { id: iconCls, name: iconCls };
            const payload = { type: 'ElePicker', data };
            window.EleManager.closePage(payload);
        }

        // 监听搜索输入变化：搜索后不自动滚动，避免打断用户焦点
        searchInput.addEventListener('input', function (e) {
            renderIcons(e.target.value, { scrollIntoView: false });
        });

        // 初始渲染：自动滚动到 URL 参数对应的已选图标
        renderIcons('', { scrollIntoView: true });
    </script>
