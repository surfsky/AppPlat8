@page
@model App.Pages.OA.ContactsModel
@{
    ViewData["Title"] = "联系人管理";
    var queryMenuId = Request.Query["menuId"].ToString();
}

@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="联系人/通讯录" FormPage="ContactForm" EnableBatch="true">
        <Toolbar>
            <Filters>
                <EleTreePicker For="Item.MenuId" Width="220px" Label="目录" Value="@QStr("menuId")" Api="/httpapi/oa/GetContactMenuTree?selectedId=@queryMenuId" Clearable="true" CheckStrictly="true"></EleTreePicker>
                <EleInput For="Item.Name" Width="180px" Label="姓名"></EleInput>
                <EleInput For="Item.Phone" Width="180px" Label="电话"></EleInput>
                <EleInput For="Item.Title" Width="180px" Label="职务"></EleInput>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" Command="Add" Icon="Plus" Visible="@HasPower(Power.ContactNew)">新增</EleButton>
                <EleButton Type="Warning" Icon="Upload" Handler="Import" Visible="@HasPower(Power.ContactNew)">导入</EleButton>
                <EleButton Type="Danger" Command="DeleteBatch" Icon="Delete" Visible="@HasPower(Power.ContactDelete)">删除</EleButton>
                <EleButton Type="Info" PopupUrl="ContactMenus" Icon="FolderOpened" Visible="@HasPower(Power.ContactMenuEdit)">目录管理</EleButton>
            </Buttons>
        </Toolbar>
        <Columns>
            <EleNumColumn></EleNumColumn>
            <EleColumn For="Item.Name" Label="姓名" Link="true" Width="160" Sortable="true"></EleColumn>
            <EleColumn For="Item.Phone" Label="电话" Width="160"></EleColumn>
            <EleColumn For="Item.Title" Label="职务" Width="140"></EleColumn>
            <EleColumn For="Item.MenuFullName" Label="目录" ></EleColumn>
            <EleColumn For="Item.DataJson" Label="属性" Width="240" MinWidth="200" Visible="false"></EleColumn>
            <EleColumn For="Item.CreateDt" Label="创建时间" Width="180" FormatString="yyyy-MM-dd HH:mm"></EleColumn>
            <EleOpColumn Width="100" Fixed="right">
                <Op Command="Edit" Icon="Edit" Tooltip="编辑" Visible="@HasPower(Power.ContactEdit)"></Op>
                <Op Command="Delete" Icon="Delete" Tooltip="删除" Visible="@HasPower(Power.ContactDelete)"></Op>
            </EleOpColumn>
        </Columns>
    </EleTable>
}
