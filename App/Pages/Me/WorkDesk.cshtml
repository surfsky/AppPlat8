@page
@model App.Pages.Me.WorkDeskModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "个人工作台";
    // ResolveUserRealName 已保证：无 URL 参数时 UserId/UserRealName 已填充为当前登录用户
    var userVal = Model.UserId.HasValue && Model.UserId > 0 ? Model.UserId.Value.ToString() : "";
    var userDisplay = (string.IsNullOrWhiteSpace(Model.UserRealName)
        ? (Model.UserId.HasValue && Model.UserId.Value > 0 ? ("ID=" + Model.UserId.Value) : "请选择人员")
        : Model.UserRealName);
    // SSR 同时把显示名写回 Model.UserName，便于 EleApp BuildAutoExposeModelJson 自动序列化到 window.model
    if (string.IsNullOrWhiteSpace(Model.UserName) && !string.IsNullOrWhiteSpace(Model.UserRealName))
        Model.UserName = Model.UserRealName;
    var activeTab = Request.Query["taskTab"].FirstOrDefault() ?? "unfinished";
    var dutyOrgSingleVal = (Model.EffectiveOrgIds != null && Model.EffectiveOrgIds.Count == 1)
        ? Model.EffectiveOrgIds[0].ToString() : "";
    var dutyOrgIdsStr    = (Model.EffectiveOrgIds != null && Model.EffectiveOrgIds.Count > 0)
        ? string.Join(",", Model.EffectiveOrgIds) : "";

    var quickEntries = new List<App.Pages.Me.WorkDeskLink>
    {
        new App.Pages.Me.WorkDeskLink { Title = "一张图",   Url = "/GIS/Index",           Target = "_blank" },
        new App.Pages.Me.WorkDeskLink { Title = "知识库",   Url = "/KB/Index",            Target = "_self"  },
        new App.Pages.Me.WorkDeskLink { Title = "值班表",   Url = "/OA/DutySchedules",    Target = "_self"  },
        new App.Pages.Me.WorkDeskLink { Title = "通讯录",   Url = "/CRM/Contacts",        Target = "_self"  },
    };
}

@section body {
<div class="w-full min-h-screen bg-white text-[15px] text-[#1e293b]">
  <div class="mx-auto w-full max-w-[1440px] px-4 py-6 sm:px-6 lg:px-8">

    <!-- 顶部：用户选择 + 组织科室入口 -->
    <!-- 注意：不使用 ElePicker 避免改动通用控件影响其他列表页。这里用极简样式 + 原生 JS 直接调 EleManager.openDrawer，选完立即改 URL 整页刷新。 -->
    <section class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-5 flex-wrap">
        <div class="inline-flex items-center">
          @{
              var canChange = Model.CanChangeScope;
              var pickerCls = canChange ? "cursor-pointer" : "cursor-not-allowed opacity-75";
              var placeholderText = string.IsNullOrWhiteSpace(userDisplay) ? "请选择人员" : userDisplay;
              var userPopupUrl = "/Admins/Users?md=select&multi=false";
              var taskTabParam = Request.Query["taskTab"].FirstOrDefault();
          }
          <div id="wd-user-picker"
               class="ele-picker-wrapper @pickerCls"
               style="width: 240px;"
               data-can-change="@(canChange ? "true" : "false")"
               data-popup-url="@userPopupUrl"
               data-current-id="@userVal"
               data-current-name="@userDisplay"
               data-task-tab="@taskTabParam">
            <div class="el-input el-input--suffix">
              <div class="el-input__wrapper">
                <div class="flex flex-wrap gap-1 items-center w-full py-1" style="min-height: 30px;">
                  @if (!string.IsNullOrWhiteSpace(userDisplay))
                  {
                      <span class="el-tag el-tag--info max-w-full overflow-hidden text-ellipsis whitespace-nowrap" disable-transitions>@placeholderText
                        @if (canChange)
                        {
                            <button id="wd-user-clear" type="button"
                                    class="el-tag__close el-icon el-icon--close cursor-pointer ml-1"
                                    aria-label="remove"
                                    style="display:inline-flex;align-items:center;justify-content:center;">×</button>
                        }
                      </span>
                  }
                  else
                  {
                      <span class="text-gray-400 text-sm">请选择人员</span>
                  }
                </div>
                <span class="el-input__suffix">
                  <span class="el-input__suffix-inner @pickerCls" style="pointer-events:auto;" title="打开选择窗口">
                    <el-icon v-if="false"></el-icon>
                    <i class="fas fa-search text-gray-400 text-sm" aria-hidden="true"></i>
                  </span>
                </span>
              </div>
            </div>
          </div>
          <input id="user-picker-id"    type="hidden" value="@userVal" />
          <input id="duty-org-id"       type="hidden" value="@dutyOrgSingleVal" />
          <input id="duty-org-ids"      type="hidden" value="@dutyOrgIdsStr" />
        </div>
        <div class="text-xs text-[#64748b] leading-snug">
          <div>默认显示当前用户</div>
          <div>仅领导或管理员可切换其他用户</div>
        </div>
      </div>
      <EleButton Type="Primary"
                 NavigateUrl="/Me/WorkDeskOrg"
                 IconCls="fas fa-building">
        组织/科室入口
      </EleButton>
    </section>

    <!-- 从快捷入口开始用独立的 EleApp Mount 容器包裹：
         内部包含 EleButton / el-tabs / EleTable 等所有 Vue 组件，保证被 Vue hydrate 出正确样式。
         顶部人员选择框（#wd-user-picker）用原生 JS 实现，放在 Vue app 外面，避免相互干扰。 -->
    <div id="wd-top">

    <!-- 快捷入口 -->
    <section class="mb-10">
      <h2 class="mb-5 text-[18px] font-semibold text-slate-800">快捷入口</h2>
      <div class="flex flex-wrap gap-4">
        @foreach (var item in quickEntries)
        {
          var blank = string.Equals(item.Target, "_blank", StringComparison.OrdinalIgnoreCase);
          if (blank)
          {
            <a target="_blank" rel="noopener" href="@item.Url" class="inline-block no-underline">
              <EleButton Type="Default"
                         Look="Plain"
                         Height="56"
                         Width="160"
                         IconCls="fas fa-bolt text-blue-500">
                @item.Title
              </EleButton>
            </a>
          }
          else
          {
            <EleButton Type="Default"
                       Look="Plain"
                       Height="56"
                       Width="160"
                       IconCls="fas fa-bolt text-blue-500"
                       NavigateUrl="@item.Url">
              @item.Title
            </EleButton>
          }
        }
      </div>
    </section>

    <!-- 我的管理对象 -->
    <section class="mb-10">
      <h2 class="mb-5 text-[18px] font-semibold text-slate-800">我的管理对象</h2>
      <div class="flex flex-wrap gap-5">
        @foreach (var c in Model.ObjectStatCards)
        {
          <div class="relative inline-block">
            <EleButton Type="Default"
                       Look="Plain"
                       Height="64"
                       Width="180"
                       NavigateUrl="@c.Url">
              @c.Title
            </EleButton>
            @if (c.ShowBadge)
            {
              <span class="absolute -right-2 -top-2 inline-flex h-6 min-w-[24px] items-center justify-center rounded-full px-2 text-[12px] font-bold text-white shadow"
                    style="background: linear-gradient(135deg, #f59e0b, #d97706);">@c.Count</span>
            }
          </div>
        }
      </div>
    </section>

    <!-- 我的隐患 -->
    <section class="mb-10">
      <h2 class="mb-5 text-[18px] font-semibold text-slate-800">我的隐患</h2>
      <div class="flex flex-wrap gap-5">
        @foreach (var c in Model.HazardStatCards)
        {
          <div class="relative inline-block">
            <EleButton Type="Default"
                       Look="Plain"
                       Height="64"
                       Width="180"
                       NavigateUrl="@c.Url">
              @c.Title
            </EleButton>
            @if (c.ShowBadge)
            {
              <span class="absolute -right-2 -top-2 inline-flex h-6 min-w-[24px] items-center justify-center rounded-full px-2 text-[12px] font-bold text-white shadow"
                    style="background: linear-gradient(135deg, #f59e0b, #d97706);">@c.Count</span>
            }
          </div>
        }
      </div>
    </section>

    <!-- 我的任务（统一最大宽度，与上方 快捷入口/管理对象/隐患 水平对齐） -->
    <section class="mb-10 w-full max-w-full">
      <h2 class="mb-4 text-[18px] font-semibold text-slate-800">我的任务</h2>

      @{
          var tabs = new[]
          {
              new { Key = "unfinished", Label = "未完成" },
              new { Key = "all",        Label = "全部"   },
              new { Key = "created",    Label = "我发起的" },
              new { Key = "handled",    Label = "我经手的" },
          };
      }

      <el-tabs tab-position="top" value="@activeTab" @@tab-change="(k)=>switchTaskTab(k)" class="w-full">
        @foreach (var t in tabs)
        {
          <el-tab-pane label="@t.Label" name="@t.Key"></el-tab-pane>
        }
      </el-tabs>
      <form id="wdTaskForm" method="get" action="@Request.Path" class="hidden">
        @if (Model.UserId.HasValue && Model.UserId.Value > 0) {
            <input type="hidden" name="userId" value="@Model.UserId.Value" />
        }
        <input id="taskTabInput" type="hidden" name="taskTab" value="@activeTab" />
      </form>

      <div class="mt-3 rounded w-full overflow-hidden">
        @{
            // 把当前 SSR 生效的 userId/taskTab 直接拼到 DataHandler URL Query 上。
            // 因为 EleTable loadData 用 axios.get(this.dataHandler, { params: {...} })，会覆盖掉原来页面 URL 上
            // 已有的 ?userId=xxx&taskTab=xxx，所以必须在这儿显式附上，否则 MyTasks handler 读不到它们，
            // 导致按默认当前用户+unfinished 查询，显示"暂无数据"或对不上。
            var effectiveUid = Model.EffectiveUserId > 0 ? Model.EffectiveUserId.ToString() : "";
            var taskDH = "?handler=MyTasks";
            if (!string.IsNullOrEmpty(effectiveUid)) taskDH += $"&userId={System.Net.WebUtility.UrlEncode(effectiveUid)}";
            if (!string.IsNullOrWhiteSpace(activeTab))  taskDH += $"&taskTab={System.Net.WebUtility.UrlEncode(activeTab)}";
        }
        <EleTable PageSize="10"
                  Title=""
                  EnableBatch="false"
                  RowKey="id"
                  Width="100%"
                  DataHandler="@taskDH">
          <Columns>
            <EleNumColumn Label="序号" Width="70" Align="center" Sortable="false" />
            <EleColumn Prop="name"         Label="名称"     MinWidth="240" Sortable="false" />
            <EleColumn Prop="levelText"    Label="级别"     MinWidth="220" Sortable="false" />
            <EleColumn Prop="creatorOrg"   Label="发起组织" MinWidth="180" Sortable="false" />
            <EleColumn Prop="progress"     Label="进度"     MinWidth="160" Sortable="false">
              <template #default="{ row }">
                <el-progress :percentage="(row && row.progress!=null)? Number(row.progress) : 0"
                             :stroke-width="10"></el-progress>
              </template>
            </EleColumn>
            <EleColumn Prop="progressText" Label="进度"     MinWidth="140" Sortable="false">
              <template #default="{ row }">
                <span v-if="row && row.progressText==='超期'"   class="text-[#d4380d] font-semibold">超期</span>
                <span v-else-if="row && row.progressText==='已完成'" class="text-[#389e0d] font-semibold">已完成</span>
                <span v-else class="text-[#1677ff] font-medium">进行中</span>
              </template>
            </EleColumn>
            <EleColumn Prop="startDt"      Label="开始日期" Width="120" FormatString="yyyy/M/d" Sortable="false" />
            <EleColumn Prop="expireDt"     Label="结束日期" Width="120" FormatString="yyyy/M/d" Sortable="false" />
            <EleLinkColumn Prop="detailUrl" Label="详情"    Width="90"  Align="center" Text="清单" Sortable="false" />
          </Columns>
        </EleTable>
      </div>
    </section>

    </div>  <!-- #wd-top 结束：保证以上快捷入口/管理对象/隐患/任务 全部在 EleApp Vue app 挂载范围内 -->

  </div>
</div>

<script>
// ----- 预挂到 window.__pageExtras.model：在 EleApp setup 里会合并到 setup bindings，
//       让 el-tabs @@tab-change="(k)=>switchTaskTab(k)" 模板表达式能直接访问（否则报 switchTaskTab is not a function）。
//       注意：EleApp 默认 exposeName 是 "model"，对应 window.__pageExtras.model 分组。
if (typeof window !== 'undefined') {
    window.__pageExtras = window.__pageExtras || {};
    window.__pageExtras.model = window.__pageExtras.model || {};
    window.__pageExtras.model.switchTaskTab = function (key) {
        var ti = document.getElementById('taskTabInput');
        if (ti) ti.value = key || 'unfinished';
        var fm = document.getElementById('wdTaskForm');
        if (fm) fm.submit();
    };
}
// 同时保留全局声明：外部脚本（非 Vue 模板内）调用时也能正常用
function switchTaskTab(key) { window.__pageExtras.model.switchTaskTab(key); }

(function () {
    // 同时把 applyUserScope 也挂到 pageExtras，将来若有需要在模板里直接调用
    if (window.__pageExtras && window.__pageExtras.model) {
        window.__pageExtras.model.applyUserScope = function (nextUserId) {
            var qs = new URLSearchParams(location.search);
            if (nextUserId) qs.set('userId', nextUserId); else qs.delete('userId');
            var url = location.pathname + (qs.toString() ? ('?' + qs.toString()) : '');
            location.assign(url);
        };
    }
    // 直接拼 URL 整页刷新：SSR 会按 URL userId/TaskTab 重算 我的管理对象 / 我的隐患 / 我的任务
    function applyUserScope(nextUserId) { window.__pageExtras.model.applyUserScope(nextUserId); }

    function makeDisplayName(r) {
        if (!r || typeof r !== 'object') return '';
        if (r.displayName && String(r.displayName).trim()) return String(r.displayName).trim();
        var real = r.realName ?? r.RealName ?? r.name ?? r.Name ?? '';
        var mob  = r.mobile ?? r.Mobile ?? '';
        if (real && mob) return real + '(' + mob + ')';
        if (real) return String(real);
        if (mob) return String(mob);
        var id = r.id != null ? r.id : r.Id;
        return id != null ? String(id) : '';
    }

    // 从 ElePicker payload 中提取 row（与 pickerMethods.handlePickerMessage / resolvePickerCloseData 对齐）
    function resolveFirstRow(payload) {
        if (!payload || typeof payload !== 'object') return null;
        // 优先：payload.type === 'ElePicker' || 'user-selected'；data 可能是 array 或对象
        if (payload.type === 'ElePicker') {
            var d = payload.data || null;
            if (Array.isArray(d) && d.length) return d[0];
            if (d && typeof d === 'object') {
                if (Array.isArray(d.rows) && d.rows.length) return d.rows[0];
                if (d.id != null || d.Id != null) return d;
            }
        }
        if (payload.type === 'user-selected') {
            var d2 = payload.data;
            if (d2 && typeof d2 === 'object' && (d2.id != null || d2.Id != null)) return d2;
            if (Array.isArray(d2) && d2.length) return d2[0];
        }
        // 外层是 closeHandler 返回的 wrapper { code, message, data: {type:ElePicker,...}, __elePageClose }
        if (payload.__elePageClose === true && payload.data && typeof payload.data === 'object') {
            return resolveFirstRow(payload.data);
        }
        if (Array.isArray(payload) && payload.length) return payload[0];
        if (payload.id != null || payload.Id != null) return payload;
        return null;
    }

    function waitForEleManager(cb, maxMs) {
        var start = Date.now();
        var iv = setInterval(function () {
            try {
                if (window.EleManager && typeof window.EleManager.openDrawer === 'function') {
                    clearInterval(iv); cb(); return;
                }
            } catch (e) {}
            if (Date.now() - start > (maxMs || 8000)) { clearInterval(iv); }
        }, 80);
    }

    function onUserSelected(payload) {
        var row = resolveFirstRow(payload);
        if (!row) return;
        var nextId = row.id != null ? String(row.id) : (row.Id != null ? String(row.Id) : '');
        if (!nextId) return;
        var idInput = document.getElementById('user-picker-id');
        if (idInput) idInput.value = nextId;
        applyUserScope(nextId);
    }

    function installUserPicker() {
        var wrap = document.getElementById('wd-user-picker');
        var idInput = document.getElementById('user-picker-id');
        if (!wrap || !idInput) return;
        var canChange = wrap.getAttribute('data-can-change') === 'true';
        var popupUrl  = wrap.getAttribute('data-popup-url') || '';

        // 点击打开用户选择 Drawer
        wrap.addEventListener('click', function (ev) {
            if (!canChange || !popupUrl) return;
            waitForEleManager(function () {
                var u = popupUrl + (popupUrl.indexOf('?') >= 0 ? '&' : '?') +
                    'pickerKey=wd_user&keyMode=Url' +
                    '&pickerValue=' + encodeURIComponent(idInput.value || '') +
                    '&pickerText='  + encodeURIComponent(wrap.getAttribute('data-current-name') || '');
                window.EleManager.openDrawer({
                    title: '选择目标人员',
                    key:   'WdUserPicker',
                    url:   u,
                    mode:  'drawer',
                    width: 900,
                    closeHandler: function (payload) {
                        // closeHandler 最优先（UserSelector 先 EleManager.closePage(payload)）
                        onUserSelected(payload);
                    }
                });
            });
        });

        // 清空按钮
        var clearBtn = document.getElementById('wd-user-clear');
        if (clearBtn && canChange) {
            clearBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                idInput.value = '';
                applyUserScope('');
            });
        }

        // 兜底 message 监听（Drawer 内嵌 iframe 场景仍可能通过 window.postMessage 回传）
        // 兼容 {type:'ElePicker', data:[row]} / {type:'user-selected', data:rowObj} / {__elePageClose,data:{type:ElePicker,...}}
        function onPickerMessage(e) {
            try {
                if (!e || !e.data) return;
                var d = e.data;
                if (typeof d === 'string') { try { d = JSON.parse(d); } catch (e2) { d = null; } }
                if (!d || typeof d !== 'object') return;
                if (d.type !== 'ElePicker' && d.type !== 'user-selected' && d.__elePageClose !== true) return;
                onUserSelected(d);
            } catch (err) {}
        }
        window.addEventListener('message', onPickerMessage);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', installUserPicker);
    } else {
        installUserPicker();
    }
})();
</script>

<EleApp Mount="#wd-top" />
}
