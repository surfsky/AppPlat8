@page
@model App.Pages.Checks.CheckTaskFormModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "检查任务信息";
    var taskId = Request.Query["id"].ToString();
}

@section body {
    <EleForm Model="form" LabelWidth="120px">
        <EleInput For="Item.Name" Label="任务名称" Required="true" FillRow="true"></EleInput>
        <EleDatePicker For="Item.StartDt" Label="开始时间" Type="Date"></EleDatePicker>
        <EleDatePicker For="Item.ExpireDt" Label="截止时间" Type="Date"></EleDatePicker>
        <EleInput For="Item.CreatorName" Label="创建人" Enabled="false"></EleInput>
        <EleInput For="Item.TotalCount" Label="总数量" ></EleInput>
        <EleInput For="Item.FinishCount" Label="已完成数量" ></EleInput>
        <EleNumber For="Item.Progress" Label="进度" Enabled="true" Precision="2" Suffix="%"></EleNumber>
        <EleInput For="Item.IsActive" Label="是否活动中" Enabled="false"></EleInput>

        <EleInput For="Item.Remark" Label="备注" Rows="3" FillRow="true"></EleInput>
        <EleInput Label="承接组织" FillRow="true" Enabled="false"></EleInput>
        <EleList Label="检查对象"
                FillRow="true"
                DataHandler="?handler=CheckObjectsData&taskId=@taskId"
                PageSize="10"
                Height="420px"
                MinHeight="240px"
                EmptyText="暂无检查对象"
                LastText=" "
                SortField="SortId"
                SortDirection="ASC"
                ScrollClass="flex-1 overflow-auto px-0"
                ItemsClass="space-y-0"
                ItemClass="py-1.5 px-0 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <ItemTemplate>
                <!-- 表头（仅首条渲染一次） -->
                <div v-if="idx === 0" class="grid grid-cols-[40px_1.8fr_1.4fr_1.2fr_90px] gap-2 px-3 py-2 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50 rounded-t">
                    <span class="text-center">序号</span>
                    <span>企业名称</span>
                    <span>组织</span>
                    <span>网格员</span>
                    <span class="text-center">状态</span>
                </div>
                <!-- 数据行 -->
                <div class="grid grid-cols-[40px_1.8fr_1.4fr_1.2fr_90px] gap-2 px-3 py-2 text-sm items-center">
                    <span class="inline-flex items-center justify-center h-[20px] rounded bg-gray-100 text-gray-600 text-xs shrink-0 text-center">{{ idx + 1 }}</span>
                    <span class="truncate text-gray-800 font-medium" :title="item.objectName">{{ item.objectName }}</span>
                    <span class="truncate text-gray-700" :title="item.dutyOrgName">{{ item.dutyOrgName }}</span>
                    <span class="truncate text-gray-700" :title="item.checkerName">{{ item.checkerName }}</span>
                    <span class="inline-flex items-center justify-center h-[22px] px-2 rounded-full text-xs whitespace-nowrap shrink-0 text-center mx-auto"
                          :class="item.isFinished ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-amber-50 text-amber-700 border border-amber-200'">
                        {{ item.statusName }}
                    </span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Text" Handler="ShowCheckObjects" EnabledFor="Item.Id">管理</EleButton>
            </Footer>
        </EleList>

        <EleList Label="附件"
                FillRow="true"
                DataHandler="?handler=AttsData&taskId=@taskId"
                PageSize="10"
                Height="240px"
                MinHeight="120px"
                EmptyText="暂无附件"
                LastText=" "
                SortField="Id"
                SortDirection="DESC"
                ScrollClass="flex-1 overflow-auto px-0"
                ItemsClass="space-y-0"
                ItemClass="py-1.5 px-0 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <ItemTemplate>
                <div v-if="idx === 0" class="grid grid-cols-[40px_1.2fr_80px_1.2fr] gap-2 px-3 py-2 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50 rounded-t">
                    <span class="text-center">序号</span>
                    <span>名称</span>
                    <span class="text-center">大小</span>
                    <span>备注</span>
                </div>
                <div class="grid grid-cols-[40px_1.2fr_80px_1.2fr] gap-2 px-3 py-2 text-sm items-center">
                    <span class="inline-flex items-center justify-center h-[20px] rounded bg-gray-100 text-gray-600 text-xs shrink-0 text-center">{{ idx + 1 }}</span>
                    <a v-if="item.url" :href="item.url" target="_blank" rel="noopener"
                       class="truncate text-blue-600 hover:text-blue-700 underline-offset-2 hover:underline font-medium"
                       :title="item.fileName ?? item.name">
                        {{ item.fileName ?? item.name }}
                    </a>
                    <span v-else class="truncate text-gray-800" :title="item.fileName ?? item.name">{{ item.fileName ?? item.name }}</span>
                    <span class="text-center text-xs text-gray-500">{{ item.fileSizeText ?? item.fileSize }}</span>
                    <span class="truncate text-gray-700" :title="item.remark">{{ item.remark }}</span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Text" Handler="ShowAtts" EnabledFor="Item.Id">管理</EleButton>
            </Footer>
        </EleList>
    
        <Bottom>
            <EleButton Type="Primary" Command="SaveClose" Visible="@(Model.Mode != PageMode.View)">保存</EleButton>
            <EleButton Command="Close">关闭</EleButton>
        </Bottom>
    </EleForm>
}