@page
@model App.Pages.Checks.CheckTaskFormModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "检查任务信息";
}

@section body {
    <EleForm Model="form" LabelWidth="120px">
        <EleInput For="Item.Name" Label="任务名称" Required="true" FillRow="true"></EleInput>
        <EleDatePicker For="Item.StartDt" Label="开始时间" Type="Date"></EleDatePicker>
        <EleDatePicker For="Item.ExpireDt" Label="截止时间" Type="Date"></EleDatePicker>
        <EleInput For="Item.CreatorName" Label="创建人" Enabled="false"></EleInput>
        <EleInput For="Item.TotalCount" Label="总数量" ></EleInput>
        <EleInput For="Item.FinishCount" Label="已完成数量" ></EleInput>
        <EleNumber For="Item.Progress" Label="进度" Enabled="true" Precision="2" Suffix="%"></EleNumber>
        <EleInput For="Item.IsActive" Label="是否活动中" Enabled="false"></EleInput>

        <EleInput Label="承接组织" FillRow="true" Enabled="false"></EleInput>
        <EleInput Label="检查企业" FillRow="true" Enabled="false"></EleInput>
        <EleInput Label="检查表单" FillRow="true" Enabled="false"></EleInput>
        <EleInput For="Item.Remark" Label="备注" Rows="3" FillRow="true"></EleInput>
    
        <Bottom>
            <EleButton Type="Primary" Command="SaveClose" Visible="@(Model.Mode != PageMode.View)">保存</EleButton>
            <EleButton Command="Close">关闭</EleButton>
        </Bottom>
    </EleForm>
}