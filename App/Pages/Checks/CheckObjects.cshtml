@page
@model App.Pages.Checks.CheckObjectsModel
@{
    ViewData["Title"] = "检查对象管理";
}

@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="检查对象" FormPage="CheckObjectForm" EnableBatch="true" >
        <Toolbar>
            <Filters>
                @* 过滤器支持 URL 参数预填充：
                   - ?orgId=730 走 Model.Item.DutyOrgId（OnGet 中已经按 orgId 查到 Org 实体并绑定到 Item）；
                   - 其它参数（?name=xxx&address=yyy 等）直接用 QStr("key") 读取（_ViewImports 全局 @using static 导入），
                     无需 Model. 前缀，简单清晰。*@
                <EleTreePicker For="DutyOrgIds" Width="300px" Label="所属网格" Multiple="true" CollapseTags="false"
                               Api="/httpapi/orgs/GetAuthOrgTree"
                               Value="@QStr("dutyOrgIds", Model.DutyOrgIds != null && Model.DutyOrgIds.Count > 0 ? string.Join(",", Model.DutyOrgIds) : "")" ></EleTreePicker>
                <EleInput For="Item.Name"              Width="250px" Label="检查对象名称"     Value="@QStr("name")"></EleInput>
                <EleInput For="Item.Address"           Width="250px" Label="详细地址"         Value="@QStr("address")"></EleInput>
                <EleSelect For="Item.Scope"            Width="250px" Label="所属领域"         Value="@QStr("scope")"></EleSelect>
                <EleSelect For="Item.IsChecked"        Width="250px" Label="是否检查"         Value="@QStr("isChecked")"></EleSelect>
                <EleSelect For="Item.HasHarzard"       Width="250px" Label="存在隐患"         Value="@QStr("hasHarzard")"></EleSelect>
                <EleInput For="Item.SocialCreditId"  Width="250px" Label="统一社会信用代码"  Value="@QStr("socialCreditCode")"></EleInput>
                <EleSelect For="Item.ObjectType"       Width="250px" Label="类型"            Value="@QStr("objectType")"></EleSelect>
                <EleSelect For="Item.RiskLevel"        Width="250px" Label="风险等级"         Value="@QStr("riskLevel")"></EleSelect>
                <EleInput For="Item.Code"              Width="250px" Label="对象标识"         Value="@QStr("code")"></EleInput>
                <EleSelect For="Item.IndustryType"     Width="250px" Label="行业"            Value="@QStr("industryType")"></EleSelect>
                <EleInput For="Item.DutyMan"      Width="250px" Label="企业责任人"          Value="@QStr("dutyUserName")"></EleInput>
                <ElePicker For="Item.CheckerId" TextFor="Item.CheckerName" Width="250px" Label="网格员" PopupUrl="/Shared/UserSelector?multi=0"
                           Value="@(Model.DefaultCheckerId.HasValue ? Model.DefaultCheckerId.Value.ToString() : QStr("checkerId"))"
                           TextValue="@Model.DefaultCheckerName"></ElePicker>
                <EleDatePicker For="Item.CreateDt" Type="DateRange" Width="250px" Label="创建时间"        Type="DateTime" Value="@QStr("createStartDt")"></EleDatePicker>
                <EleDatePicker For="Item.LastCheckDt" Type="DateRange" Width="250px" Label="巡查时间"     Type="DateTime" Value="@QStr("lastCheckStartDt")"></EleDatePicker>
                <EleSelect For="Item.IndustryRisk"     Width="250px" Label="行业风险类型"     Value="@QStr("industryRisk")"></EleSelect>
                <EleTreePicker For="Item.TagIds" Label="标签" Api="/httpapi/checks/GetCheckTagTree" Multiple="true" CollapseTags="false" FillRow="true" Value="@QStr("tagIds")"></EleTreePicker>
                <EleSelect For="Item.IsDel"            Width="250px" Label="已删除"           Value="@QStr("isDel", "false")"></EleSelect>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" Command="Add" Icon="Plus" Visible="@Auth.CheckPower(Power.CheckObjectNew)">新增</EleButton>
                <EleButton Type="Danger" Command="DeleteBatch" Icon="Delete" Visible="@Auth.CheckPower(Power.CheckObjectDelete)">删除</EleButton>
                <EleButton Type="Warning" Icon="Upload" Handler="Import" Visible="@Auth.CheckPower(Power.CheckObjectEdit)">导入</EleButton>
                <EleButton Type="Primary" Command="Export" Icon="Download" Visible="@Auth.CheckPower(Power.CheckObjectExport)">导出</EleButton>
                <EleButton Type="Warning" Icon="Edit" Visible="@Auth.CheckPower(Power.CheckObjectEdit)">批量修改
                    <BatchFields>
                        <BatchField Control="Picker"  Field="CheckerId" TextFor="CheckerName" Label="网格员" PopupUrl="/Admins/Users?multi=false&md=Select" />
                        <BatchField Control="Input"   Field="DutyMan"   Label="企业负责人" Placeholder="留空则不更新" />
                        <BatchField Control="Input"   Field="SafeMan"   Label="安全管理员" Placeholder="留空则不更新" />
                        <BatchField Control="Select"  Field="RiskLevel" Label="风险等级"   Options="无风险,低风险,中风险,高风险" />
                    </BatchFields>
                </EleButton>
            </Buttons>
        </Toolbar>
        <Columns>
            <EleNumColumn Fixed="left"></EleNumColumn>
            <EleOpColumn Width="120" Fixed="right" Shows="3">
                <Op Command="Edit"   Icon="Edit" Tooltip="编辑" Visible="@Auth.CheckPower(Power.CheckObjectEdit)"></Op>
                <Op Command="Delete" Icon="Delete" Tooltip="删除" Visible="false"></Op>
                <Op Popup="/Checks/CheckFlow?objectId={id}&objectName={name}"   Icon="DocumentChecked" Text="开始排查" Visible="@Auth.CheckPower(Power.CheckNew)"></Op>
                <Op Popup="/Checks/ObjectContacts?objectId={id}&objectName={name}"   Icon="User" Text="联系人" Visible="@Auth.CheckPower(Power.CheckObjectView)"></Op>
                <Op Popup="/Checks/CheckHazards?objectId={id}&objectName={name}"   Icon="WarningFilled" Text="隐患清单" Visible="@Auth.CheckPower(Power.CheckHazardView)"></Op>
                <Op Popup="/Checks/Checks?objectId={id}&objectName={name}"   Icon="DocumentChecked" Text="排查历史" Visible="@Auth.CheckPower(Power.CheckView)"></Op>
                <Op Popup="/Checks/CheckPoints?objectId={id}&objectName={name}"   Icon="DocumentChecked" Text="风险点清单" Visible="@Auth.CheckPower(Power.CheckObjectView)"></Op>
                <Op Popup="/Shared/Atts?uniId=CheckObject-{id}&name={name}"   Icon="Paperclip" Text="附件" Visible="@Auth.CheckPower(Power.CheckObjectView)"></Op>
                <Op Popup="/Checks/CheckObjectEvents?objectId={id}&objectName={name}"   Icon="DocumentChecked" Text="事件事故" Visible="@Auth.CheckPower(Power.CheckObjectView)"></Op>
            </EleOpColumn>
            <EleColumn For="Item.Id" Label="Id" Link="true" Width="60" Sortable="true"></EleColumn>
            <EleColumn For="Item.Name" Label="名称" Link="true" MinWidth="300" Sortable="true"></EleColumn>
            <EleColumn For="Item.Address" Label="地址" Width="200"></EleColumn>
            <EleColumn For="Item.SocialCreditId" Label="社会信用代码" Width="180"></EleColumn>
            <EleColumn For="Item.TagNames" Label="标签列表" MinWidth="220"></EleColumn>
            <EleColumn For="Item.LastCheckDt" Label="巡查时间" Width="150" FormatString="yyyy-MM-dd HH:mm"></EleColumn>
            <EleColumn For="Item.NextCheckDt" Label="下次巡查时间" Width="150" FormatString="yyyy-MM-dd HH:mm"></EleColumn>

            <EleColumn For="Item.DutyOrgName" Label="责任网格" Width="200"></EleColumn>
            <EleColumn For="Item.DutyMan" Label="企业负责人" Width="120"></EleColumn>
            <EleColumn For="Item.CheckerName" Label="网格员" Width="120"></EleColumn>

            <EleColumn For="Item.RiskLevel" Label="风险等级" Width="100"></EleColumn>
            <EleColumn For="Item.Scope" Label="领域" Width="100"></EleColumn>
            <EleColumn For="Item.ObjectType" Label="类型" Width="100"></EleColumn>
            <EleColumn For="Item.IndustryType" Label="行业" Width="110" ></EleColumn>
            <EleColumn For="Item.IndustryRisk" Label="行业风险" Width="100"></EleColumn>

            <EleColumn For="Item.Scale" Label="规模" Width="100"></EleColumn>
            <EleColumn For="Item.ArchieveDt" Label="建档日期" Width="110" FormatString="yyyy-MM-dd"></EleColumn>

            <EleColumn For="Item.DutySectionName" Label="责任科室" Width="200" Sortable="false"></EleColumn>
            <EleColumn For="Item.DutyUnitName" Label="责任单位" Width="200" Sortable="false"></EleColumn>
            <EleColumn For="Item.DutyTownName" Label="责任乡镇" Width="200" Sortable="false"></EleColumn>
            <EleColumn For="Item.BuildingType" Label="建筑类型" Width="100" ></EleColumn>

            <EleColumn For="Item.HasHarzard" Label="存在隐患" Width="100"></EleColumn>
            <EleColumn For="Item.Code" Label="编码" Width="120" Sortable="true"></EleColumn>
            <EleColumn For="Item.IsDel" Label="是否失效" Width="100"></EleColumn>
        </Columns>
    </EleTable>
}
