@page
@model App.Pages.Checks.CheckTasksModel
@{
    ViewData["Title"] = "检查任务管理";
}

@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="检查任务" FormPage="CheckTaskForm" EnableBatch="true" >
        <Toolbar>
            <Filters>
                <EleInput For="Item.Name" Width="250px" Label="名称" ></EleInput>
                <EleDatePicker For="Item.StartDt" Width="250px"Label="开始时间" ></EleDatePicker>
                <EleDatePicker For="Item.ExpireDt" Width="250px"Label="截止时间" ></EleDatePicker>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" Command="Add" Icon="Plus">新增</EleButton>
                <EleButton Type="Danger" Command="BatchDelete" Icon="Delete">删除</EleButton>
            </Buttons>
        </Toolbar>
        <Columns>
            <EleNumColumn></EleNumColumn>
            <EleOpColumn Width="100" Fixed="right">
                <Op Command="Edit"   Icon="Edit" Tooltip="编辑" Visible="@Auth.CheckPower(Power.CheckTaskEdit)"></Op>
                <Op Command="Delete" Icon="Delete" Tooltip="删除" Visible="@Auth.CheckPower(Power.CheckTaskDelete)"></Op>
            </EleOpColumn>
            <EleColumn For="Item.Name" Label="任务名称" Link="true" MinWidth="280"></EleColumn>
            <EleColumn For="Item.IsActive" Label="是否活动中" Width="120"></EleColumn>
            <EleColumn For="Item.TotalCount" Label="总数量" Width="100"></EleColumn>
            <EleColumn For="Item.FinishCount" Label="已完成数量" Width="100"></EleColumn>
            <EleColumn For="Item.Progress" Label="进度" Width="100">
                <template #default="{ row }">
                    <el-progress :percentage="row.progress"></el-progress>
                </template>
            </EleColumn>
            <EleColumn For="Item.CreatorName" Label="发布人" Width="120"></EleColumn>
            <EleColumn For="Item.StartDt" Label="开始时间" Width="200" FormatString="yyyy-MM-dd"></EleColumn>
            <EleColumn For="Item.ExpireDt" Label="截止时间" Width="120" FormatString="yyyy-MM-dd"></EleColumn>
            <EleColumn For="Item.Remark" Label="备注" Width="200"></EleColumn>
        </Columns>
    </EleTable>
}
