@page
@model App.Pages.Checks.CheckTaskObjectsModel
@{
    ViewData["Title"] = "检查任务对象";
    var dataHandler = "?handler=Data";
    if (Model.Item.TaskId.GetValueOrDefault() > 0) dataHandler += $"&taskId={Model.Item.TaskId}";
    if (Model.Item.OrgId.GetValueOrDefault() > 0) dataHandler += $"&orgId={Model.Item.OrgId}";
    if (Model.Item.CheckerId.GetValueOrDefault() > 0) dataHandler += $"&checkerId={Model.Item.CheckerId}";
    if (!string.IsNullOrWhiteSpace(Model.ScopeStatus)) dataHandler += $"&status={Uri.EscapeDataString(Model.ScopeStatus)}";
}

@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="检查任务对象" DataHandler="@dataHandler">
        <Toolbar>
            <Filters>
                <EleNumber For="Item.TaskId" Prop="taskId" Width="180px" Label="任务 ID" Value="@(Model.Item.TaskId?.ToString() ?? string.Empty)"></EleNumber>
                <EleTreePicker For="Item.OrgId" Prop="orgId" Width="240px" Label="责任组织"
                               Api="/httpapi/orgs/GetAuthOrgTree?selectedId=@Model.Item.OrgId" ExpandLevel="3" CheckStrictly="true"
                               Value="@(Model.Item.OrgId?.ToString() ?? string.Empty)"></EleTreePicker>
                <ElePicker For="Item.CheckerId" TextFor="CheckerName" Prop="checkerId" Api="/httpapi/users/GetPicker" Width="220px" Label="检查人"
                           Value="@(Model.Item.CheckerId?.ToString() ?? string.Empty)" TextValue="@Model.CheckerName"></ElePicker>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
            </Buttons>
        </Toolbar>
        <Columns>
            <EleNumColumn></EleNumColumn>
            <EleColumn For="Item.TaskName" Label="任务名称" MinWidth="180" Link="true" PopupUrl="/Checks/Flow/CheckTaskForm?id={taskId}&md=View"></EleColumn>
            <EleColumn For="Item.ObjectName" Label="检查对象" MinWidth="200" Link="true" PopupUrl="/Checks/CheckObjectForm?id={checkObjectId}&md=View"></EleColumn>
            <EleColumn For="Item.OrgName" Label="责任组织" MinWidth="160"></EleColumn>
            <EleColumn For="Item.CheckerName" Label="检查人" MinWidth="120"></EleColumn>
            <EleColumn For="Item.Status" Label="检查状态" Width="120"></EleColumn>
            <EleColumn For="Item.HazardCnt" Label="发现隐患数" Width="110"></EleColumn>
            <EleColumn For="Item.FixHazardCnt" Label="已整改隐患数" Width="130"></EleColumn>
            <EleColumn For="Item.SortId" Label="排序" Width="80"></EleColumn>
        </Columns>
    </EleTable>
}
