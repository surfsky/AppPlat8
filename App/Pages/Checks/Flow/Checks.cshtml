@page
@model App.Pages.Checks.ChecksModel
@{
    ViewData["Title"] = "检查记录管理";
    var objectNameEncoded = System.Net.WebUtility.UrlEncode(Model.ObjectName ?? string.Empty);
    var titleSuffix = string.IsNullOrWhiteSpace(Model.ObjectName) ? string.Empty : $" - {Model.ObjectName}";
}

@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="检查记录" FormPage="CheckLogForm" EnableBatch="true" DataHandler="?handler=Data&objectId=@Model.ObjectId&objectName=@objectNameEncoded" >
        <Toolbar>
            <Filters>
                <EleInput For="Item.CheckObject.Name" Width="250px" Label="对象名称" ></EleInput>
                <EleInput For="Item.Checker.Name" Width="250px" Label="检查人" ></EleInput>
                <EleDatePicker For="Item.CheckDt" Label="检查时间" Width="250px"></EleDatePicker>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" PopupUrl="/Checks/Flow/CheckFlow?objectId=@Model.ObjectId&objectName=@objectNameEncoded" Icon="DocumentChecked" Visible="@(Model.ObjectId.GetValueOrDefault() > 0 && Auth.HasPower(Power.CheckNew))">开始排查</EleButton>
                <EleButton Type="Danger" Command="DeleteBatch" Icon="Delete">删除</EleButton>
            </Buttons>
        </Toolbar>
        <Columns>
            <EleNumColumn></EleNumColumn>
            <EleOpColumn Width="60" Fixed="right">
                <Op Command="Delete" Icon="Delete" Tooltip="删除" Visible="@Auth.HasPower(Power.CheckDelete) && Auth.HasPower(Power.AdminOrg)"></Op>
            </EleOpColumn>
            <EleColumn For="Item.CheckDt" Label="检查时间" Width="120" FormatString="yyyy-MM-dd HH:mm"></EleColumn>
            <EleColumn For="Item.CheckObjectName" Label="检查对象" MinWidth="150"></EleColumn>
            <EleColumn For="Item.CheckerRealName" Label="检查人" Width="100"></EleColumn>
            <EleColumn For="Item.TaskNames" Label="关联任务" MinWidth="180"></EleColumn>
            <EleColumn For="Item.Result" Label="是否有隐患" Width="80"></EleColumn>
            <EleColumn For="Item.HazardCount" Label="隐患数" Width="80"
                       PopupUrl="/Checks/Flow/CheckHazards?objectId={checkObjectId}&objectName={checkObjectName}&checkId={id}"
                       PopupTitle="隐患清单"></EleColumn>
            <EleColumn For="Item.RemainHazardCount" Label="未处理隐患数" Width="80"></EleColumn>
        </Columns>
    </EleTable>
}
