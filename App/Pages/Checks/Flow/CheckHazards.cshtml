@page
@model App.Pages.Checks.CheckHazardsModel
@{
    ViewData["Title"] = "隐患管理";
    var objectNameEncoded = System.Net.WebUtility.UrlEncode(Model.ObjectName ?? string.Empty);

    var dataHandler = $"?handler=Data&objectId={Model.ObjectId}&objectName={objectNameEncoded}";
    var orgId = Request.Query["orgId"].FirstOrDefault();
    var scopeOrgOnly = Request.Query["scopeOrgOnly"].FirstOrDefault();
    var scopeCheckerOrOrg = Request.Query["scopeCheckerOrOrg"].FirstOrDefault();
    var checkStartDt = Request.Query["checkStartDt"].FirstOrDefault();
    var checkEndDt = Request.Query["checkEndDt"].FirstOrDefault();
    var taskId = Request.Query["taskId"].FirstOrDefault();
    var status = Request.Query["status"].FirstOrDefault();
    var selectedOrgId = !string.IsNullOrWhiteSpace(orgId) ? orgId : (Model.OrgId?.ToString() ?? string.Empty);
    if (Model.CheckId.GetValueOrDefault() > 0)         dataHandler += $"&checkId={Model.CheckId.Value}";
    if (Model.ScopeExcludeArchived)                    dataHandler += "&excludeArchived=true";
    if (!string.IsNullOrWhiteSpace(orgId))             dataHandler += $"&orgId={orgId}";
    if (!string.IsNullOrWhiteSpace(scopeOrgOnly))      dataHandler += $"&scopeOrgOnly={scopeOrgOnly}";
    if (!string.IsNullOrWhiteSpace(scopeCheckerOrOrg)) dataHandler += $"&scopeCheckerOrOrg={scopeCheckerOrOrg}";
    if (!string.IsNullOrWhiteSpace(checkStartDt))      dataHandler += $"&checkStartDt={Uri.EscapeDataString(checkStartDt)}";
    if (!string.IsNullOrWhiteSpace(checkEndDt))        dataHandler += $"&checkEndDt={Uri.EscapeDataString(checkEndDt)}";
    if (!string.IsNullOrWhiteSpace(taskId))            dataHandler += $"&taskId={Uri.EscapeDataString(taskId)}";
    if (!string.IsNullOrWhiteSpace(status))            dataHandler += $"&status={Uri.EscapeDataString(status)}";
}

@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="隐患" FormPage="CheckHazardForm" EnableBatch="true" DataHandler="@dataHandler" >
        <Toolbar>
            <Filters>
                <EleTreePicker For="OrgId" Prop="orgId" Width="260px" Label="网格区域"
                               Api="/httpapi/orgs/GetAuthOrgTree?selectedId=@selectedOrgId" ExpandLevel="3" CheckStrictly="true"
                               Value="@selectedOrgId">
                </EleTreePicker>
                <EleInput For="Item.Description" Width="250px" Label="描述" ></EleInput>
                <EleInput For="Item.Check.CheckObject.Name" Prop="objectName" Width="250px" Label="对象" Value="@Q("objectName")" ></EleInput>
                <ElePicker For="Item.CheckerId" TextFor="Item.CheckerName" Prop="checkerId" Api="/httpapi/users/GetPicker" Width="200px" Label="检查人" Value="@(Model.ScopeCheckerId.HasValue ? Model.ScopeCheckerId.Value.ToString() : "")" TextValue="@Model.ScopeCheckerName"></ElePicker>
                <EleDatePicker For="checkStartDt" Prop="checkStartDt" Width="220px" Label="检查开始"
                               Value="@(Model.checkStartDt.HasValue ? Model.checkStartDt.Value.ToString("yyyy-MM-ddTHH:mm:ss") : "")"
                               Type="@EleDatePickerType.DateTime">
                </EleDatePicker>
                <EleDatePicker For="checkEndDt" Prop="checkEndDt" Width="220px" Label="检查结束"
                               Value="@(Model.checkEndDt.HasValue ? Model.checkEndDt.Value.ToString("yyyy-MM-ddTHH:mm:ss") : "")"
                               Type="@EleDatePickerType.DateTime">
                </EleDatePicker>
                <EleSelect For="Item.Status" Width="200px" Label="状态" Clearable="true" Value="@Model.ScopeStatus" Multiple="true"></EleSelect>
                <EleDatePicker For="Item.ExpireDt" Prop="expireTo" Width="200px" Label="整改期限至" Value="@(Model.ScopeExpireTo.HasValue ? Model.ScopeExpireTo.Value.ToString("yyyy-MM-dd") : "")"></EleDatePicker>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" Icon="Plus" PopupUrl="CheckFlow" Visible="false">新增</EleButton>
                <EleButton Type="Danger" Command="DeleteBatch" Icon="Delete">删除</EleButton>
            </Buttons>
        </Toolbar>
        <Columns>
            <EleNumColumn></EleNumColumn>
            <EleOpColumn Width="100" Fixed="right">
                <Op Command="Edit"   Icon="Edit" Tooltip="处理" Visible="@Auth.HasPower(Power.CheckHazardEdit)"></Op>
                <Op Command="Delete" Icon="Delete" IconColor="Danger" Tooltip="删除" Visible="@Auth.HasPower(Power.CheckHazardDelete) && Auth.HasPower(Power.AdminOrg)"></Op>
            </EleOpColumn>
            <EleColumn For="Item.CreateDt" Label="创建时间" Width="120" FormatString="yyyy-MM-dd HH:mm"></EleColumn>
            <EleColumn For="Item.CheckItemText" Label="检查项" MinWidth="250"  Link="true"></EleColumn>
            <EleColumn For="Item.Status" Label="状态" Width="80"></EleColumn>
            <EleColumn For="Item.HazardLevel" Label="隐患等级" Width="100" ></EleColumn>
            <EleColumn For="Item.CheckerName" Label="检查人" MinWidth="100" ></EleColumn>
            <EleColumn For="Item.ObjectName" Label="检查对象" MinWidth="150" PopupUrl="/checks/CheckObjectForm?id={checkObjectId}"></EleColumn>
            <EleColumn For="Item.CheckSheetName" Label="检查表" MinWidth="150" ></EleColumn>
            <EleColumn For="Item.Description" Label="隐患描述" MinWidth="200" ></EleColumn>
            <EleColumn For="Item.ExpireDt" Label="整改期限" Width="120" FormatString="yyyy-MM-dd"></EleColumn>
            <EleColumn For="Item.RectifyDt" Label="整改日期" Width="120" FormatString="yyyy-MM-dd"></EleColumn>
            <EleColumn For="Item.IsIn141" Label="入141" Width="80" ></EleColumn>
            <EleColumn For="Item.OrgName" Label="组织" MinWidth="150" ></EleColumn>
        </Columns>
    </EleTable>
}
