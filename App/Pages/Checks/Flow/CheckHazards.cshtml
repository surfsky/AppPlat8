@page
@model App.Pages.Checks.CheckHazardsModel
@{
    ViewData["Title"] = "隐患管理";
    var objectNameEncoded = System.Net.WebUtility.UrlEncode(Model.ObjectName ?? string.Empty);
    var titleSuffix = string.IsNullOrWhiteSpace(Model.ObjectName) ? string.Empty : $" - {Model.ObjectName}";
    // DataHandler 携带无对应过滤控件的 scope 参数（excludeArchived）；其余参数（checkerId/status/expireTo）由过滤控件的 data-filter-default 机制注入
    var dataHandler = $"?handler=Data&objectId={Model.ObjectId}&objectName={objectNameEncoded}";
    if (Model.ScopeExcludeArchived) dataHandler += "&excludeArchived=true";
}

@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="隐患" FormPage="CheckHazardForm" EnableBatch="true" DataHandler="@dataHandler" >
        <Toolbar>
            <Filters>
                <EleInput For="Item.Description" Width="250px" Label="描述" ></EleInput>
                <EleInput For="Item.Check.CheckObject.Name" Prop="objectName" Width="250px" Label="对象" Value="@Q("objectName")" ></EleInput>
                <ElePicker For="Item.CheckerId" TextFor="Item.CheckerName" Prop="checkerId" Api="/httpapi/users/GetPicker" Width="200px" Label="检查人" Value="@(Model.ScopeCheckerId.HasValue ? Model.ScopeCheckerId.Value.ToString() : "")" TextValue="@Model.ScopeCheckerName"></ElePicker>
                <EleSelect For="Item.Status" Width="200px" Label="状态" Clearable="true" Value="@Model.ScopeStatus" Multiple="true"></EleSelect>
                <EleDatePicker For="Item.ExpireDt" Prop="expireTo" Width="200px" Label="整改期限至" Value="@(Model.ScopeExpireTo.HasValue ? Model.ScopeExpireTo.Value.ToString("yyyy-MM-dd") : "")"></EleDatePicker>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" Icon="Plus" PopupUrl="CheckFlow" Visible="false">新增</EleButton>
                <EleButton Type="Danger" Command="DeleteBatch" Icon="Delete">删除</EleButton>
            </Buttons>
        </Toolbar>
        <Columns>
            <EleNumColumn></EleNumColumn>
            <EleOpColumn Width="100" Fixed="right">
                <Op Command="Edit"   Icon="Edit" Tooltip="处理" Visible="@Auth.CheckPower(Power.CheckHazardEdit)"></Op>
                <Op Command="Delete" Icon="Delete" Tooltip="删除" Visible="@Auth.CheckPower(Power.CheckHazardDelete)"></Op>
            </EleOpColumn>
            <EleColumn For="Item.ObjectName" Label="检查对象" MinWidth="150"></EleColumn>
            <EleColumn For="Item.CheckSheetName" Label="检查表" MinWidth="150" ></EleColumn>
            <EleColumn For="Item.CheckerName" Label="检查人" MinWidth="100" ></EleColumn>
            <EleColumn For="Item.CheckItemText" Label="检查项" MinWidth="250"  Link="true"></EleColumn>
            <EleColumn For="Item.Description" Label="隐患描述" MinWidth="200" ></EleColumn>
            <EleColumn For="Item.HazardLevel" Label="隐患等级" Width="100" ></EleColumn>
            <EleColumn For="Item.Status" Label="状态" Width="100"></EleColumn>
            <EleColumn For="Item.ExpireDt" Label="整改期限" Width="200" FormatString="yyyy-MM-dd"></EleColumn>
            <EleColumn For="Item.RectifyDt" Label="整改日期" Width="200" FormatString="yyyy-MM-dd"></EleColumn>
            <EleColumn For="Item.IsIn141" Label="入141" Width="80" ></EleColumn>
        </Columns>
    </EleTable>
}