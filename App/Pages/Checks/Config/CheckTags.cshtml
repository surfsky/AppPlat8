@page
@model App.Pages.Checks.CheckTagsModel
@{
    ViewData["Title"] = "检查项标签管理";
}

@section body {
    <EleTable PageSize="100" Title="检查项标签管理" FormPage="CheckTagForm" EnableBatch="false"  RowKey="id" >
        <Toolbar>
            <Filters>
                <EleInput For="Item.Name" Width="200px" Label="名称" Placeholder="请输入标签名称" Clearable="true"></EleInput>
                <EleSelect For="Item.TagType" Width="160px" Label="类型" Clearable="true"></EleSelect>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search" Width="120px">查询</EleButton>
                <EleButton Type="Primary" Command="Add" Icon="Plus" Width="120px">新增</EleButton>
            </Buttons>
        </Toolbar>
        <Columns>
            <EleOpColumn Width="100">
                <Op Command="Edit"   Icon="Edit" Tooltip="编辑"></Op>
                <Op Command="Delete" Icon="Delete" Tooltip="删除"></Op>
            </EleOpColumn>
            <EleColumn For="Item.Name" Label="名称" MinWidth="200"></EleColumn>
            <EleColumn For="Item.Id" Label="Id" Width="120"></EleColumn>
            <EleColumn For="Item.TagType" Label="类型" Width="120"></EleColumn>
            <EleColumn For="Item.SortId" Label="顺序" Width="120"></EleColumn>
        </Columns>
    </EleTable>
}
