@page
@model App.Pages.Checks.CheckObjectFormModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "检查对象信息";
}

@section body {
    <EleForm>
        <EleHidden For="Item.Id"></EleHidden>
        <EleLabel Label="基础信息" FillRow="true" Color="#0A79C4" ></EleLabel>
        <EleImageUpload For="Item.OutlookImage" Label="外观图片" FillRow="true"></EleImageUpload>
        <EleInput For="Item.Name" Label="名称" Required="true"></EleInput>
        <EleInput For="Item.SocialCreditId" Label="社会信用代码"></EleInput>
        <EleInput For="Item.Code" Label="编码"></EleInput>
        <EleInput For="Item.AreaCode" Label="地块号"></EleInput>
        <EleInput For="Item.Address" Label="地址"></EleInput>
        <ElePicker For="Item.Gps" TextFor="Item.Gps" Label="地图定位" PopupUrl="/GIS/Locator" Icon="Location"></ElePicker>
        <EleDatePicker For="Item.ArchieveDt" Label="建档日期"></EleDatePicker>
        <EleDatePicker For="Item.LastCheckDt" Label="最后巡查时间" Type="@EleDatePickerType.DateTime"></EleDatePicker>
        <EleSwitch For="Item.HasHarzard" Label="是否存在隐患"></EleSwitch>
        <EleSwitch For="Item.IsDel" Label="是否失效"></EleSwitch>
        <div v-show="form.isDel === true">
            <EleSelect For="Item.FailReason" Label="失效原因" FillRow="true" ></EleSelect>
        </div>

        <EleLabel Label="营业信息" FillRow="true" Color="#0A79C4" Bold="true"></EleLabel>
        <EleImageUpload For="Item.LicenseImage" Label="工商执照" FillRow="true"></EleImageUpload>
        <EleSelect For="Item.ObjectType" Label="对象类型" Placeholder="请选择"></EleSelect>
        <EleListPicker For="Item.Scope" Label="领域"></EleListPicker>
        <EleSelect For="Item.IndustryType" Label="行业类型"></EleSelect>
        <EleSelect For="Item.Scale" Label="规模"></EleSelect>
        <EleInput For="Item.ProductContent" Label="生产内容" Rows="1" FillRow="true"></EleInput>
        <EleInput For="Item.EleMeeterNum" Label="电表号"></EleInput>
        <EleNumber For="Item.EmployeeCount" Label="员工数"></EleNumber>

        <EleLabel Label="责任信息" Color="#0A79C4" FillRow="true"></EleLabel>
        <EleTreePicker For="Item.DutyOrgId" Label="责任网格" Api="/httpapi/orgs/GetAuthOrgTree" ></EleTreePicker>
        <ElePicker For="Item.CheckerId" TextFor="Item.CheckerName" Label="技术检查员" PopupUrl="/Shared/UserSelector?multi=0"></ElePicker>
        <EleInput For="Item.DutyMan" Label="企业负责人"></EleInput>
        <EleInput For="Item.SafeMan" Label="安全管理员"></EleInput>
        <EleInput For="Item.SafeSteward" Label="安全管家"></EleInput>
        <EleInput For="Item.SafeAgency" Label="三方机构"></EleInput>


        <EleLabel Label="风险信息" FillRow="true"></EleLabel>
        <EleSelect For="Item.RiskLevel" Label="风险等级" ></EleSelect>
        <EleSelect For="Item.IndustryRisk" Label="行业风险"></EleSelect>


        <EleLabel Label="建筑信息" FillRow="true"></EleLabel>
        <EleSelect For="Item.BuildingType" Label="建筑类型" ></EleSelect>
        <EleNumber For="Item.LandArea" Label="占地面积" Append="㎡" ControlPosition="right" ></EleNumber>
        <EleNumber For="Item.BuildingArea" Label="建筑面积" Append="㎡" ControlPosition="right" ></EleNumber>
        <EleSelect For="Item.FactoryUsageType" Label="厂房使用权"></EleSelect>
        <EleSelect For="Item.BuildingStructure" Label="房屋结构"></EleSelect>


        <EleLabel Label="更多" FillRow="true"></EleLabel>
        <EleTreePicker For="Item.TagIds" Label="标签" Api="/httpapi/checks/GetCheckTagTreeForSheet?objectId=@Model.Item.Id" Multiple="true" CollapseTags="false" FillRow="true"></EleTreePicker>
        
        <EleList Label="联系人" FillRow="true" DataHandler="?handler=ContactsData&objectId=@Model.Item.Id" PageSize="5" Height="160px" EmptyText="" LastText=" " SortField="Id" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="shrink-0 w-16 text-center">类型</span>
                    <span class="flex-1">姓名</span>
                    <span class="shrink-0 text-center">电话</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <span class="text-xs text-gray-400 shrink-0 w-16 truncate">{{ item.contactTypeName }}</span>
                    <a href="javascript:void(0)" class="text-sm text-gray-800 hover:text-blue-600 truncate flex-1"
                       :title="item.name"
                       v-on:click="openLinkInDrawer(`/Checks/ObjectContactForm?id=${item.id}&objectId=${item.checkObjectId}&md=View`, item.name)">{{ item.name }}</a>
                    <span class="text-xs text-gray-500 shrink-0">{{ item.phone }}</span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit" Handler="ShowContacts" EnabledFor="Item.Id">管理</EleButton>
            </Footer>
        </EleList>

        <EleList Label="文档" FillRow="true" DataHandler="?handler=FilesData&objectId=@Model.Item.Id" PageSize="5" Height="160px" EmptyText="" SortField="Id" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="flex-1">名称</span>
                    <span class="shrink-0 text-center">大小</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <a href="javascript:void(0)" class="text-sm text-gray-800 hover:text-blue-600 truncate flex-1"
                       :title="item.fileName"
                       v-on:click="openLinkInDrawer(`/Shared/FileViews/Viewer?id=${item.id}&uniId=${item.key}`, item.fileName, '60%')">{{ item.fileName }}</a>
                    <span class="text-xs text-gray-400 shrink-0">{{ item.fileSizeText }}</span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit" Handler="ShowFiles" EnabledFor="Item.Id">管理</EleButton>
            </Footer>
        </EleList>



        <!--检查点 CheckPoints/CheckPointForm -->
        <EleList Label="检查点" FillRow="true" DataHandler="?handler=CheckPointsData&objectId=@Model.Item.Id" PageSize="5" Height="200px" EmptyText="" SortField="Id" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="shrink-0 w-16 text-center">等级</span>
                    <span class="flex-1">名称</span>
                    <span class="shrink-0 w-24 text-center">坐标</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <span class="inline-flex items-center justify-center px-2 h-[20px] rounded-full text-xs whitespace-nowrap shrink-0 w-16"
                          :class="item.riskLevel == null ? 'bg-gray-100 text-gray-500' : (item.riskLevel >= 3 ? 'bg-red-50 text-red-600 border border-red-200' : (item.riskLevel >= 2 ? 'bg-yellow-50 text-yellow-700 border border-yellow-200' : 'bg-green-50 text-green-700 border border-green-200'))"
                          v-if="item.riskLevelName">{{ item.riskLevelName }}</span>
                    <span class="shrink-0 w-16 text-center text-xs text-gray-400" v-else>-</span>
                    <a href="javascript:void(0)" class="text-sm text-gray-800 hover:text-blue-600 truncate flex-1"
                       :title="item.name"
                       v-on:click="openLinkInDrawer(`/Checks/CheckPointForm?id=${item.id}&objectId=${item.checkObjectId}&md=View`, item.name)">{{ item.name }}</a>
                    <span class="text-xs text-gray-400 shrink-0 w-24 truncate" :title="item.gps">{{ item.gps }}</span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit" Handler="ShowCheckPoints" EnabledFor="Item.Id">管理</EleButton>
            </Footer>
        </EleList>
        
        <EleList Label="检查历史" FillRow="true" DataHandler="?handler=CheckLogsData&objectId=@Model.Item.Id" PageSize="5" Height="160px" EmptyText="" SortField="CheckDt" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="shrink-0 w-24 text-center">检查时间</span>
                    <span class="flex-1">检查人</span>
                    <span class="shrink-0 text-center">隐患</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <span class="text-xs text-gray-400 shrink-0 w-24 truncate">{{ item.checkDtText }}</span>
                    <a href="javascript:void(0)" class="text-sm text-gray-800 hover:text-blue-600 truncate flex-1"
                       :title="item.checkDtText"
                       v-on:click="openLinkInDrawer(`/Checks/Flow/CheckForm?id=${item.id}&md=View`, '隐患排查' +item.checkDtText)">{{ item.checkerName }}</a>
                    <span class="text-xs text-gray-500 shrink-0" v-if="item.hazardCount > 0">隐患 {{ item.hazardCount }}</span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit"  Handler="ShowCheckLogs" EnabledFor="Item.Id">管理</EleButton>
            </Footer>
        </EleList>

        <EleList Label="隐患清单" FillRow="true" DataHandler="?handler=HazardsData&objectId=@Model.Item.Id" PageSize="5" Height="160px" EmptyText="" SortField="Id" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="shrink-0 w-24 text-center">检查日期</span>
                    <span class="flex-1">描述</span>
                    <span class="shrink-0 w-14 text-center">状态</span>
                    <span class="shrink-0 text-center">期限</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <span class="text-xs text-gray-400 shrink-0 w-24 truncate">{{ item.createDt }}</span>
                    <a href="javascript:void(0)" class="text-sm text-gray-800 hover:text-blue-600 truncate flex-1"
                       :title="item.description"
                       v-on:click="openLinkInDrawer(`/Checks/Flow/CheckHazardForm?id=${item.id}&md=View`, item.description)">{{ item.description }}</a>
                    <span class="text-xs text-gray-500 shrink-0 w-14 truncate">{{ item.statusName }}</span>
                    <span class="text-xs text-gray-400 shrink-0">{{ item.expireDtText }}</span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit" Handler="ShowHazards">管理</EleButton>
            </Footer>
        </EleList>


        <EleList Label="事件" FillRow="true" DataHandler="?handler=EventsData&objectId=@Model.Item.Id" PageSize="5" Height="160px" EmptyText="" SortField="Id" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="shrink-0 text-center">时间</span>
                    <span class="flex-1">标题</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <span class="text-xs text-gray-400 shrink-0">{{ item.triggleDtText }}</span>
                    <a href="javascript:void(0)" class="text-sm text-gray-800 hover:text-blue-600 truncate flex-1"
                       :title="item.title"
                       v-on:click="openLinkInDrawer(`/Checks/CheckObjectEventForm?id=${item.id}&objectId=${item.checkObjectId}&md=View`, item.title)">{{ item.title }}</a>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit" Handler="ShowObjectEvents" EnabledFor="Item.Id">管理</EleButton>
            </Footer>
        </EleList>


    
        <Bottom>
            <EleButton Type="Primary" Icon="Select" Command="SaveClose" Visible="@(Model.Mode != PageMode.View)">保存</EleButton>
            <EleButton Type="Success" Icon="Search" PopupUrl="/Checks/CheckFlow?objectId=@Model.Item.Id&objectName=@UrlEncode(Model.Item.Name ?? string.Empty)" EnabledFor="Item.Id" Visible="@Auth.CheckPower(Power.CheckNew)">开始排查</EleButton>
            <EleButton Command="Close" Icon="Close">关闭</EleButton>
        </Bottom>
    </EleForm>
}
