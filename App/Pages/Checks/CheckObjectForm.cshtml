@page
@model App.Pages.Checks.CheckObjectFormModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "检查对象信息";
}

@section body {
    <EleForm>
        <EleHidden For="Item.Id"></EleHidden>
        <EleLabel Label="基础信息" FillRow="true" Color="#0A79C4" ></EleLabel>
        <EleImageUpload For="Item.OutlookImage" Label="外观图片" FillRow="true"></EleImageUpload>
        <EleInput For="Item.Name" Label="名称" Required="true"></EleInput>
        <EleInput For="Item.Address" Label="地址" Required="true"></EleInput>
        <EleInput For="Item.SocialCreditId" Label="社会信用代码"></EleInput>
        <EleInput For="Item.Code" Label="编码"></EleInput>
        <EleInput For="Item.AreaCode" Label="地块号"></EleInput>
        <ElePicker For="Item.Gps" TextFor="Item.Gps" Label="地图定位" PopupUrl="/GIS/Locator" Icon="Location" TagType="Warning"></ElePicker>
        <EleDatePicker For="Item.ArchieveDt" Label="建档日期"></EleDatePicker>
        <EleDatePicker For="Item.LastCheckDt" Label="最后巡查时间" Type="@EleDatePickerType.DateTime"></EleDatePicker>
        <EleSwitch For="Item.IsDel" Label="是否失效" Enabled="false"></EleSwitch>
        <div v-show="form.isDel === true">
            <EleSelect For="Item.FailReason" Label="失效原因" FillRow="true" ></EleSelect>
        </div>

        <EleLabel Label="风险信息" FillRow="true" ></EleLabel>
        <EleSelect For="Item.ObjectType" Label="类型" Placeholder="请选择" Required="true"></EleSelect>
        <EleListPicker For="Item.Scope" Label="领域" Required="true" Icon="ArrowRight"></EleListPicker>
        <EleSelect For="Item.IndustryType" Label="行业类型" Required="false" Visible="false"></EleSelect>
        <EleSelect For="Item.Scale" Label="规模" Required="false" Visible="false"></EleSelect>
        <EleTreePicker For="Item.TagIds"     Required="true" Label="标签" Api="/httpapi/checks/GetCheckTagTreeForObject?objectId=@Model.Item.Id&tagType=Basic" Multiple="true" CollapseTags="false" FillRow="true" TagType="Warning" ExpandLevel="2" ChunkSelectable="false"></EleTreePicker>
        <EleTreePicker For="Item.TagSpecIds" Label="扩展标签" Api="/httpapi/checks/GetCheckTagTreeForObject?objectId=@Model.Item.Id&tagType=Spec" Multiple="true" CollapseTags="false" FillRow="true" TagType="Danger" ExpandLevel="2" ChunkSelectable="false"></EleTreePicker>
        <EleSelect For="Item.RiskLevel" Label="风险等级" ></EleSelect>
        <EleSelect For="Item.IndustryRisk" Label="行业风险" Visible="false"></EleSelect>
        <EleSwitch For="Item.HasHarzard" Label="是否存在隐患" Enabled="false"></EleSwitch>


        <EleLabel Label="营业信息" FillRow="true" Color="#0A79C4" Bold="true"></EleLabel>
        <EleImageUpload For="Item.LicenseImage" Label="工商执照" FillRow="true"></EleImageUpload>
        <EleInput For="Item.ProductContent" Label="生产内容" Rows="1" FillRow="true"></EleInput>
        <EleInput For="Item.EleMeeterNum" Label="电表号"></EleInput>
        <EleNumber For="Item.EmployeeCount" Label="员工数"></EleNumber>


        <EleLabel Label="责任信息" Color="#0A79C4" FillRow="true"></EleLabel>
        <EleTreePicker For="Item.OrgId" Label="责任网格" Api="/httpapi/orgs/GetAuthOrgTree" Required="true" ExpandLevel="3"></EleTreePicker>
        <ElePicker For="Item.CheckerId" TextFor="CheckerName" Label="网格员" PopupUrl="/Shared/UserSelector?multi=0" Required="true" ></ElePicker>
        <EleInput For="Item.DutyMan" Label="企业负责人"></EleInput>
        <EleInput For="Item.SafeMan" Label="安全管理员"></EleInput>
        <EleInput For="Item.SafeSteward" Label="安全管家"></EleInput>
        <EleInput For="Item.SafeAgency" Label="三方机构"></EleInput>
        <EleInput For="Item.SafeOfficer" Label="首席安全官"></EleInput>


        <EleLabel Label="建筑信息" Color="#0A79C4" FillRow="true"></EleLabel>
        <EleSelect For="Item.BuildingType" Label="建筑类型" ></EleSelect>
        <EleNumber For="Item.LandArea" Label="占地面积" Append="㎡" ControlPosition="right" ></EleNumber>
        <EleNumber For="Item.BuildingArea" Label="建筑面积" Append="㎡" ControlPosition="right" ></EleNumber>
        <EleSelect For="Item.FactoryUsageType" Label="厂房使用权"></EleSelect>
        <EleSelect For="Item.BuildingStructure" Label="房屋结构"></EleSelect>




        <EleLabel Label="更多" Color="#0A79C4" FillRow="true"></EleLabel>

        <!-- 联系人  -->
        <EleList Label="联系人" FillRow="true" DataHandler="?handler=ContactsData&objectId=@Model.Item.Id" PageSize="5" MinHeight="160px" EmptyText="" LastText=" " SortField="Id" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="shrink-0 w-16 text-center">类型</span>
                    <span class="flex-1">姓名</span>
                    <span class="shrink-0 text-center">电话</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <span class="text-xs text-gray-800 shrink-0 w-16 truncate text-center">{{ item.contactTypeName }}</span>
                    <a href="javascript:void(0)" class="text-sm text-blue-800 hover:text-blue-600 truncate flex-1"
                       :title="item.name"
                       v-on:click="openLinkInDrawer(`/Checks/ObjectContactForm?id=${item.id}&objectId=${item.checkObjectId}&md=View`, item.name)">{{ item.name }}</a>
                    <span class="text-xs text-gray-500 shrink-0 text-center">{{ item.phone }}</span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit" Handler="ShowContacts" EnabledFor="Item.Id" Visible="@HasPower(Power.CheckObjectEdit)">管理</EleButton>
            </Footer>
        </EleList>

        <!-- 隐患清单  -->
        <EleList Label="隐患清单" FillRow="true" DataHandler="?handler=HazardsData&objectId=@Model.Item.Id" PageSize="5" MinHeight="160px" EmptyText="" SortField="Id" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="shrink-0 w-28 text-center">检查日期</span>
                    <span class="flex-1 min-w-0">描述</span>
                    <span class="shrink-0 w-20 text-center">状态</span>
                    <span class="shrink-0 w-32 text-center">期限</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <a href="javascript:void(0)" class="text-xs text-blue-800 hover:text-blue-600 shrink-0 w-28 truncate text-center"
                       :title="item.createDtText"
                           v-on:click="openLinkInDrawer(`/Checks/Flow/CheckHazardForm?id=${item.id}&md=View`, item.description)">{{ item.createDtText }}
                    </a>
                    <span class="flex-1 text-xs min-w-0 truncate" :title="item.description">{{ item.description }}</span>
                    <span class="text-xs text-gray-500 shrink-0 w-20 truncate text-center">{{ item.statusName }}</span>
                    <span class="text-xs text-gray-400 shrink-0 w-32 truncate text-center">{{ item.expireDtText }}</span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit" Handler="ShowHazards" Visible="@HasPower(Power.CheckObjectEdit)">管理</EleButton>
            </Footer>
        </EleList>


        <!-- 检查历史  -->
        <EleList Label="检查历史" FillRow="true" DataHandler="?handler=CheckLogsData&objectId=@Model.Item.Id" PageSize="5" MinHeight="160px" EmptyText="" SortField="CheckDt" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="shrink-0 w-24 text-center">检查时间</span>
                    <span class="flex-1">检查人</span>
                    <span class="shrink-0 text-center">隐患</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <a href="javascript:void(0)" class="text-xs text-blue-800 shrink-0 w-24 truncate text-center"
                       :title="item.checkDtText"
                       v-on:click="openLinkInDrawer(`/Checks/Flow/CheckForm?id=${item.id}&md=View`, '隐患排查' +item.checkDtText)">{{ item.checkDtText }}</a>
                    <span class="text-sm text-gray-800 truncate flex-1">{{ item.checkerName }}</span>
                    <span class="text-xs text-gray-500 shrink-0 text-center" v-if="item.hazardCount > 0">隐患 {{ item.hazardCount }}</span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit"  Handler="ShowCheckLogs" EnabledFor="Item.Id" Visible="@HasPower(Power.CheckObjectEdit)">管理</EleButton>
            </Footer>
        </EleList>
        


        <!--检查点 CheckPoints/CheckPointForm -->
        <EleList Label="检查点" FillRow="true" DataHandler="?handler=CheckPointsData&objectId=@Model.Item.Id" PageSize="5" MinHeight="200px" EmptyText="" SortField="Id" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="shrink-0 w-16 text-center">等级</span>
                    <span class="flex-1">名称</span>
                    <span class="shrink-0 w-24 text-center">坐标</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <span class="inline-flex items-center justify-center px-2 h-[20px] rounded-full text-xs whitespace-nowrap shrink-0 w-16"
                          :class="item.riskLevel == null ? 'bg-gray-100 text-gray-500' : (item.riskLevel >= 3 ? 'bg-red-50 text-red-600 border border-red-200' : (item.riskLevel >= 2 ? 'bg-yellow-50 text-yellow-700 border border-yellow-200' : 'bg-green-50 text-green-700 border border-green-200'))"
                          v-if="item.riskLevelName">{{ item.riskLevelName }}</span>
                    <span class="shrink-0 w-16 text-center text-xs text-gray-400" v-else>-</span>
                    <a href="javascript:void(0)" class="text-xs text-blue-800 hover:text-blue-600 truncate flex-1"
                       :title="item.name"
                       v-on:click="openLinkInDrawer(`/Checks/CheckPointForm?id=${item.id}&objectId=${item.checkObjectId}&md=View`, item.name)">{{ item.name }}</a>
                    <span class="text-xs text-gray-400 shrink-0 w-24 truncate text-center" :title="item.gps">{{ item.gps }}</span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit" Handler="ShowCheckPoints" EnabledFor="Item.Id" Visible="@HasPower(Power.CheckObjectEdit)">管理</EleButton>
            </Footer>
        </EleList>
        


        <!-- 事件  -->
        <EleList Label="事件台账" FillRow="true" DataHandler="?handler=EventsData&objectId=@Model.Item.Id" PageSize="5" MinHeight="160px" EmptyText="" SortField="Id" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="shrink-0 w-24 text-center">时间</span>
                    <span class="flex-1">标题</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <span class="text-xs text-gray-800 shrink-0 w-24 truncate text-center">{{ item.happenDtText }}</span>
                    <a href="javascript:void(0)" class="text-xs text-blue-800 hover:text-blue-600 truncate flex-1"
                       :title="item.title"
                       v-on:click="openLinkInDrawer(`/Checks/CheckObjectEventForm?id=${item.id}&objectId=${item.checkObjectId}&md=View`, item.title)">{{ item.title }}</a>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit" Handler="ShowObjectEvents" EnabledFor="Item.Id" Visible="@HasPower(Power.CheckObjectEdit)">管理</EleButton>
            </Footer>
        </EleList>

        
        <!-- 文档  -->
        <EleList Label="文档资料" FillRow="true" DataHandler="?handler=FilesData&objectId=@Model.Item.Id" PageSize="5" MinHeight="160px" EmptyText="" SortField="Id" SortDirection="DESC" ScrollClass="flex-1 overflow-auto" ItemsClass="space-y-0.5" ItemClass="py-1 px-2 border-b border-gray-100 rounded-none bg-transparent shadow-none">
            <Header>
                <div class="flex items-center justify-between gap-2 px-2 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-200 bg-gray-50">
                    <span class="flex-1">名称</span>
                    <span class="shrink-0 text-center">大小</span>
                </div>
            </Header>
            <ItemTemplate>
                <div class="flex items-center justify-between gap-2 text-sm">
                    <a href="javascript:void(0)" class="text-sm text-blue-800 hover:text-blue-600 truncate flex-1"
                       :title="item.fileName"
                       v-on:click="openLinkInDrawer(`/Shared/FileViews/Viewer?id=${item.id}&uniId=${item.key}`, item.fileName, '60%')">{{ item.fileName }}</a>
                    <span class="text-xs text-gray-400 shrink-0 text-center">{{ item.fileSizeText }}</span>
                </div>
            </ItemTemplate>
            <Footer>
                <EleButton Type="Primary" Look="Plain" Icon="Edit" Handler="ShowFiles" EnabledFor="Item.Id" Visible="@HasPower(Power.CheckObjectEdit)">管理</EleButton>
            </Footer>
        </EleList>

        
        <!-- 扩展信息  -->
        <EleProperty For="Item.Remark" Label="扩展信息" FillRow="true" Height="1000px" ButtonPosition="Bottom" ButtonText="&nbsp;添加"></EleProperty>

    
        <Bottom>
            <EleButton Type="Primary" Icon="Select" Command="SaveClose" Visible="@(Model.Mode != PageMode.View)">保存</EleButton>
            <EleButton Type="Success" Icon="Search" PopupUrl="/Checks/flow/CheckFlow?objectId=@Model.Item.Id&objectName=@UrlEncode(Model.Item.Name ?? string.Empty)" EnabledFor="Item.Id" Visible="@Auth.HasPower(Power.CheckNew)" PopupTitle="隐患排查">开始排查</EleButton>
            <EleButton Command="Close" Icon="Close">关闭</EleButton>
        </Bottom>
    </EleForm>
}
