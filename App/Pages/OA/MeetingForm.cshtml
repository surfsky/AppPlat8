@page
@model App.Pages.OA.MeetingFormModel
@{
    ViewData["Title"] = "会议记录";
}

@section body {
    <EleForm LabelWidth="100px">
        <EleDatePicker For="Item.Day" Label="日期" Required="true" Type="Date"></EleDatePicker>
        <EleSelect For="Item.Type" Label="类别" Required="true"></EleSelect>
        <EleTreePicker For="Item.OrgId" Label="科室" Api="/httpapi/orgs/GetAuthOrgTree" Required="true"></EleTreePicker>
        <EleImageUpload For="Item.Image" Label="照片" ColSpan="24"></EleImageUpload>
        <EleInput For="Item.Content" Label="内容" Rows="6" ColSpan="24"></EleInput>
        <Bottom>
            <EleButton Type="Primary" Command="SaveClose" Visible="@(Model.Mode != PageMode.View)">保存</EleButton>
            <EleButton Command="Close">关闭</EleButton>
        </Bottom>
    </EleForm>
}