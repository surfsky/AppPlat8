@page
@model App.Pages.OA.DutySchedulesModel
@{
    ViewData["Title"] = "值班表管理";
}

@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="值班表" FormPage="DutyScheduleForm" EnableBatch="true">
        <Toolbar>
            <Filters>
                <EleDatePicker For="Item.Day" Type="DateRange"  Width="220px" Label="日期" Type="Date"> </EleDatePicker>
                <EleInput    VModel="filters.keyword" Prop="keyword"   Width="320px" Label="值班人员/手机" ></EleInput>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" Command="Add"    Icon="Plus"   Visible="@Auth.CheckPower(Power.DutyScheduleNew)">新增值班</EleButton>
                <EleButton Type="Primary" Command="Export" Icon="Download" Visible="@Auth.CheckPower(Power.DutyScheduleExport)">导出</EleButton>
                <EleButton Type="Danger"  Command="DeleteBatch" Icon="Delete" Visible="@Auth.CheckPower(Power.DutyScheduleDelete)">删除</EleButton>
            </Buttons>
        </Toolbar>
        <Columns>
            <EleNumColumn></EleNumColumn>
            <EleOpColumn Width="120" Fixed="right" Shows="2">
                <Op Command="Edit"   Icon="Edit"   Tooltip="编辑" Visible="@Auth.CheckPower(Power.DutyScheduleEdit)"></Op>
                <Op Command="Delete" Icon="Delete" Tooltip="删除" Visible="@Auth.CheckPower(Power.DutyScheduleDelete)"></Op>
            </EleOpColumn>
            <EleColumn For="Item.Id"        Label="Id"  Width="60"  Sortable="true"></EleColumn>
            <EleColumn For="Item.Day"       Label="日期" Width="120" FormatString="yyyy-MM-dd" Sortable="true"></EleColumn>
            <EleColumn For="Item.Leader"    Label="值班领导"  Width="200"></EleColumn>
            <EleColumn For="Item.Chief"     Label="值班长"    Width="200"></EleColumn>
            <EleColumn For="Item.Member1"   Label="值班员1" Width="200"></EleColumn>
            <EleColumn For="Item.Member2"   Label="值班员2" Width="200"></EleColumn>
            <EleColumn For="Item.Member3"   Label="值班员3" Width="200"></EleColumn>
            <EleColumn For="Item.Member4"   Label="值班员4" Width="200"></EleColumn>
            <EleColumn For="Item.Member5"   Label="值班员5" Width="200"></EleColumn>
            <EleColumn For="Item.Member6"   Label="值班员6" Width="200"></EleColumn>
            <EleColumn For="Item.Member7"   Label="值班员7" Width="200"></EleColumn>
            <EleColumn For="Item.Member8"   Label="值班员8" Width="200"></EleColumn>
            <EleColumn For="Item.Member9"   Label="值班员9" Width="200"></EleColumn>
            <EleColumn For="Item.Member10"  Label="值班员10" Width="200"></EleColumn>
            <EleColumn For="Item.Member11"  Label="值班员11" Width="200"></EleColumn>
            <EleColumn For="Item.Member12"  Label="值班员12" Width="200"></EleColumn>
            <EleColumn For="Item.Member13"  Label="值班员13" Width="200"></EleColumn>
            <EleColumn For="Item.Member14"  Label="值班员14" Width="200"></EleColumn>
            <EleColumn For="Item.Member15"  Label="值班员15" Width="200"></EleColumn>
            <EleColumn For="Item.UpdateDt"  Label="更新时间" Width="150" FormatString="yyyy-MM-dd HH:mm" Sortable="true"></EleColumn>
        </Columns>
    </EleTable>
}
