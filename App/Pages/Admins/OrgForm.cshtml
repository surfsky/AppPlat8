@page
@model App.Pages.Admins.OrgFormModel
@{
    ViewData["Title"] = "组织表单";
}

@section body {
    <EleForm LabelWidth="100px">
        <EleInput For="Item.Name" Label="名称" Required="true"></EleInput>
        <EleTreePicker For="Item.ParentId" Label="上级组织" Api="/httpapi/orgs/GetAuthOrgTree"  Clearable="true" CheckStrictly="true"></EleTreePicker>
        <EleNumber For="Item.SortId" Label="排序" Min="0" Max="1000"></EleNumber>
        <EleSelect For="Item.Level" Label="级别" Required="true"></EleSelect>
        <ElePicker For="Item.Gps" TextFor="Item.Gps" Label="定位" Class="gps-picker" PopupUrl="../gis/Locator" Icon="Location" Editable="true"></ElePicker>
        <ElePicker For="Item.GeoData" TextFor="Item.GeoData" Label="图形数据" Class="geojson-picker" PopupUrl="../gis/GeometryEditor" KeyMode="Storage" Icon="Location" Rows="12" Editable="true" FillRow="true"></ElePicker>
        <EleInput For="Item.Remark" Label="备注" Rows="3" FillRow="true"></EleInput>
    
        <Bottom>
            <EleButton Type="Primary" Command="SaveClose"  Icon="Check" Visible="@(Model.Mode != PageMode.View)">保存</EleButton>
            <EleButton Command="Close" Icon="Close">关闭</EleButton>
        </Bottom>
    </EleForm>
}
