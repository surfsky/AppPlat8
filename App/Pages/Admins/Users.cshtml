@page
@model App.Pages.Admins.UsersModel
@{
    ViewData["Title"] = "用户管理";
}


@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="用户" FormPage="UserForm" EnableBatch="false" >
        <Toolbar>
            <Filters>
                <EleInput For="Item.Name" Label="账号" Width="260px"></EleInput>
                <EleInput For="Item.RealName" Label="姓名" Width="260px"></EleInput>
                <EleTreePicker For="Item.OrgId" Label="部门" Api="/httpapi/orgs/GetAuthOrgTree" Clearable="true" Width="280px"></EleTreePicker>
                <EleSelect For="RoleId" Label="角色" Items="Model.RoleList" Clearable="true" Width="220px"></EleSelect>
                <EleSelect For="Item.IsDel" Label="是否失效" Items="new []{false,true}" Value="false"></EleSelect>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" Command="Add" Icon="Plus">新增</EleButton>
                <EleButton Type="Danger" Command="BatchDelete" Icon="Delete" visible="false">删除</EleButton>
                <EleButton Type="Success" PopupUrl="Orgs" PopupTitle="组织管理" IconCls="fas fa-sitemap" Visible="false">组织管理</EleButton>
                <EleButton Type="Success" Command="Export" Icon="Download" visible="false">导出</EleButton>
                <EleButton Type="Warning" Icon="Upload" Handler="Import" Visible="@Auth.CheckPower(Power.UserNew)">导入</EleButton>
            </Buttons>
        </Toolbar>
        <Columns>
            <EleNumColumn></EleNumColumn>
            <EleOpColumn Width="100" Fixed="right" Shows="3">
                <Op Command="Edit" Tooltip="编辑" Icon="Edit" Visible="@Auth.CheckPower(Power.UserEdit)"></Op>
                <Op Command="Delete" Tooltip="删除" Icon="Delete" Visible="@Auth.CheckPower(Power.UserDelete)"></Op>
                <Op Handler="resetPasswordToDefault(scope.row)" Tooltip="修改密码" Icon="Key" Visible="@Model.CanResetPassword"></Op>
            </EleOpColumn>
            <EleImageColumn For="Item.Photo" Label="头像" Width="60" Sortable="false"></EleImageColumn>
            <EleColumn For="Item.Name" Label="账号" Link="true" Width="120" Sortable="true"></EleColumn>
            <EleColumn For="Item.RealName" Label="姓名" Width="120" Sortable="true"></EleColumn>
            <EleColumn For="Item.OrgFullName" Label="组织全名" ></EleColumn>
            <EleColumn For="Item.Title" Label="职务" Width="120"></EleColumn>
            <EleColumn For="Item.IsDel" Label="是否失效" Width="80" ></EleColumn>
            <EleColumn For="Item.Gender" Label="性别" Width="60"></EleColumn>
            <EleColumn For="Item.Email" Label="邮箱" Width="180"></EleColumn>
            <EleColumn For="Item.CreateDt" Label="创建时间" Width="120" FormatString="yyyy-MM-dd HH:mm"></EleColumn>
            <EleColumn For="Item.RoleNames" Label="角色" Width="180"></EleColumn>
        </Columns>
    </EleTable>
}

@section script {
    <script>
        const userMixin = {
            methods: {
                // 管理员可将指定用户密码重置为站点配置中的默认密码。
                async resetPasswordToDefault(row) {
                    const userId = Number(row?.id || 0);
                    if (!userId) {
                        EleManager.showError('未找到有效的用户标识');
                        return;
                    }

                    const displayName = row?.name || row?.realName || ('ID=' + userId);
                    try {
                        await EleManager.confirm(`确定将用户“${displayName}”的密码重置为默认密码吗？`);
                    } catch (err) {
                        return;
                    }

                    await this.postHandler('ResetPasswordToDefault', { id: userId });
                }
            }
        };
    </script>
}
