@page
@model App.Pages.Admins.RoleMenuModel
@{
    ViewData["Title"] = "角色系统菜单";
}

@section body {
<div id="app" class="h-screen flex flex-col overflow-hidden bg-white">
    <div class="h-[50px] px-4 flex items-center gap-2 sticky top-0 z-10">
        <el-button type="primary" v-on:click="save" :loading="saving" :disabled="!roleId">
            <el-icon class="mr-1"><Check /></el-icon>
            保存
        </el-button>
        <div class="ml-auto flex items-center">
            <el-switch
                v-model="allChecked"
                inline-prompt
                active-text="全选"
                inactive-text="清空"
                :disabled="!roleId"
                v-on:change="handleAllToggle">
            </el-switch>
        </div>
    </div>

    <div v-loading="loading" class="flex-1 min-h-0 overflow-auto p-3">
        <el-tree
            ref="treeRef"
            :data="menus"
            node-key="id"
            show-checkbox
            default-expand-all
            :expand-on-click-node="false"
            check-on-click-node
            :props="treeProps">
            <template #default="{ data }">
                <span>{{ data.name }}</span>
            </template>
        </el-tree>
    </div>
</div>
}

@section script {
<script>
const { createApp, ref, onMounted } = Vue;
const { ElMessage } = ElementPlus;

const app = createApp({
    setup() {
        const roleId = ref(Number('@Model.RoleId') || 0);
        const loading = ref(false);
        const saving = ref(false);
        const allChecked = ref(false);
        const menus = ref([]);
        const treeRef = ref(null);
        const treeProps = { children: 'children', label: 'name' };

        const getCsrfToken = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        const flattenIds = (list, ids = []) => {
            (list || []).forEach(n => {
                ids.push(n.id);
                flattenIds(n.children || [], ids);
            });
            return ids;
        };

        const load = async () => {
            if (!roleId.value) return;
            loading.value = true;
            try {
                const [menuRes, roleRes] = await Promise.all([
                    axios.get('?handler=Menus'),
                    axios.get(`?handler=RoleMenuIds&roleId=${roleId.value}`)
                ]);
                menus.value = menuRes.data.data || [];
                await Vue.nextTick();
                treeRef.value?.setCheckedKeys(roleRes.data.data || []);
                allChecked.value = (treeRef.value?.getCheckedKeys(false) || []).length > 0;
            } catch (err) {
                ElMessage.error('加载菜单数据失败');
            } finally {
                loading.value = false;
            }
        };

        const handleAllToggle = (checked) => {
            const ids = flattenIds(menus.value);
            treeRef.value?.setCheckedKeys(checked ? ids : []);
        };

        const save = async () => {
            if (!roleId.value) return;
            saving.value = true;
            try {
                // 仅保存真正勾选的节点，避免半选父节点回填时把整棵子树重新勾满。
                const checked = treeRef.value?.getCheckedKeys(false) || [];
                const ids = Array.from(new Set(checked || [])).map(Number);

                const res = await axios.post('?handler=SaveRoleMenus', {
                    roleId: roleId.value,
                    menuIds: ids,
                }, {
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken(),
                    }
                });

                if (res.data.code === 0) ElMessage.success('保存成功');
                else ElMessage.error(res.data.msg || '保存失败');
            } finally {
                saving.value = false;
            }
        };

        onMounted(load);

        return {
            roleId,
            loading,
            saving,
            allChecked,
            menus,
            treeRef,
            treeProps,
            handleAllToggle,
            save,
        };
    }
});

app.use(ElementPlus);
for (const [key, component] of Object.entries(ElementPlusIconsVue)) {
    app.component(key, component);
}
app.mount('#app');
</script>
}
