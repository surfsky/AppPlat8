@page
@model App.Pages.Admins.RolePowerModel
@{
    ViewData["Title"] = "角色操作权限";
}

@section body {
<div id="app" class="h-screen flex flex-col overflow-hidden bg-white">
    <div class="h-[50px] px-4 flex items-center gap-2">
        <el-button type="primary" v-on:click="savePowers" :loading="saving" :disabled="!roleId">
            <el-icon class="mr-1"><Check /></el-icon>
            保存
        </el-button>
        <div class="ml-auto flex items-center">
            <el-switch
                v-model="allChecked"
                inline-prompt
                active-text="全选"
                inactive-text="清空"
                :disabled="!roleId"
                v-on:change="handleAllToggle">
            </el-switch>
        </div>
    </div>

    <div v-loading="loading" class="flex-1 min-h-0 overflow-y-auto">
        <div class="h-[38px] flex border-b border-gray-200 text-gray-700 font-medium">
            <div class="w-[180px] px-4 py-1.5 border-r border-gray-200 font-bold">权限分组</div>
            <div class="flex-1 px-4 py-1.5 font-bold">权限清单</div>
        </div>

        <div v-for="group in groupPowers" :key="group.groupName" class="flex border-b border-gray-200">
            <div class="w-[180px] px-4 py-1 border-r border-gray-200 bg-white font-bold">
                <el-checkbox
                    v-model="group.checkAll"
                    :indeterminate="group.isIndeterminate"
                    v-on:change="(val) => handleCheckAllChange(val, group)">
                    {{ group.groupName }}
                </el-checkbox>
            </div>
            <div class="flex-1 px-4 py-1 bg-white">
                <el-checkbox-group v-model="currentPowerIds" v-on:change="() => handleCheckedPowersChange(group)">
                    <span class="inline-block min-w-[124px] mr-3 mb-1" v-for="power in group.powers" :key="power.id">
                        <el-checkbox :label="power.id">{{ power.title }}</el-checkbox>
                    </span>
                </el-checkbox-group>
            </div>
        </div>
    </div>
</div>
}

@section script {
<script>
const { createApp, ref, onMounted } = Vue;
const { ElMessage } = ElementPlus;

const app = createApp({
    setup() {
        const roleId = ref(Number('@Model.RoleId') || 0);
        const groupPowers = ref([]);
        const currentPowerIds = ref([]);
        const allChecked = ref(false);
        const loading = ref(false);
        const saving = ref(false);

        const getCsrfToken = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        const loadGroupPowers = async () => {
            const res = await axios.get('?handler=GroupPowers');
            groupPowers.value = (res.data.data || []).map(g => ({
                ...g,
                powers: (g.powers || []).map(p => ({ ...p, id: String(p.id) })),
                checkAll: false,
                isIndeterminate: false
            }));
        };

        const loadRolePowers = async () => {
            if (!roleId.value) return;
            loading.value = true;
            try {
                const res = await axios.get(`?handler=RolePowerIds&roleId=${roleId.value}`);
                currentPowerIds.value = (res.data.data || []).map(x => String(x));
                updateGroupCheckState();
            } finally {
                loading.value = false;
            }
        };

        const updateGroupCheckState = () => {
            groupPowers.value.forEach(group => {
                const ids = group.powers.map(t => String(t.id));
                const cnt = ids.filter(id => currentPowerIds.value.includes(id)).length;
                group.checkAll = cnt > 0 && cnt === ids.length;
                group.isIndeterminate = cnt > 0 && cnt < ids.length;
            });

            const allIds = [];
            groupPowers.value.forEach(g => g.powers.forEach(p => allIds.push(String(p.id))));
            allChecked.value = allIds.length > 0 && allIds.every(id => currentPowerIds.value.includes(id));
        };

        const handleCheckAllChange = (val, group) => {
            const ids = group.powers.map(t => String(t.id));
            if (val) {
                ids.forEach(id => {
                    if (!currentPowerIds.value.includes(id)) currentPowerIds.value.push(id);
                });
            } else {
                currentPowerIds.value = currentPowerIds.value.filter(id => !ids.includes(id));
            }
            updateGroupCheckState();
        };

        const handleCheckedPowersChange = () => updateGroupCheckState();

        const selectAllPowers = (checked) => {
            const allIds = [];
            groupPowers.value.forEach(g => g.powers.forEach(p => allIds.push(String(p.id))));
            currentPowerIds.value = checked ? allIds : [];
            updateGroupCheckState();
        };

        const handleAllToggle = (checked) => selectAllPowers(checked);

        const savePowers = async () => {
            if (!roleId.value) return;
            saving.value = true;
            try {
                const res = await axios.post('?handler=SaveRolePowers', {
                    roleId: roleId.value,
                    powerIds: currentPowerIds.value.map(x => Number(x)),
                }, {
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken(),
                    }
                });

                if (res.data.code === 0) ElMessage.success('保存成功');
                else ElMessage.error(res.data.msg || '保存失败');
            } finally {
                saving.value = false;
            }
        };

        onMounted(async () => {
            await loadGroupPowers();
            await loadRolePowers();
        });

        return {
            roleId,
            groupPowers,
            currentPowerIds,
            loading,
            saving,
            allChecked,
            savePowers,
            selectAllPowers,
            handleAllToggle,
            handleCheckAllChange,
            handleCheckedPowersChange,
        };
    }
});

app.use(ElementPlus);
for (const [key, component] of Object.entries(ElementPlusIconsVue)) {
    app.component(key, component);
}
app.mount('#app');
</script>
}
