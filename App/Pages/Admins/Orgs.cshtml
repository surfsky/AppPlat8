@page
@model App.Pages.Admins.OrgsModel
@{
    ViewData["Title"] = "组织管理";
}

@section body {
    <EleTable PageSize="@SiteConfig.Instance.PageSize" Title="组织管理" FormPage="OrgForm" EnableBatch="false" RowKey="id">
        <Toolbar>
            <Filters>
                <EleInput For="Item.Name" Width="500px" Label="名称" ></EleInput>
            </Filters>
            <Buttons>
                <EleButton Type="Primary" Command="Search" Icon="Search">查询</EleButton>
                <EleButton Type="Primary" Command="Add" Icon="Plus">新增组织</EleButton>
                <EleButton Type="Warning" Icon="Refresh" VClick="postHandler('FixAll').then(() => loadData())" Visible="@Auth.HasPermission(Permission.OrgEdit)">补全全称</EleButton>
                <EleButton Type="Warning" Handler="MoveFirst" Icon="ArrowUp" Payload="SelectInfo" >到顶</EleButton>
                <EleButton Type="Warning" Handler="MoveUp" Icon="ArrowUp" Payload="SelectInfo" >上移</EleButton>
                <EleButton Type="Warning" Handler="MoveDown" Icon="ArrowDown" Payload="SelectInfo" >下移</EleButton>
                <EleButton Type="Warning" Handler="MoveLast" Icon="ArrowDown" Payload="SelectInfo" >到底</EleButton>
            </Buttons>
        </Toolbar>
        <Columns>
            <EleOpColumn Width="100">
                <Op Command="Edit" Tooltip="编辑" Icon="Edit" Visible="@Auth.HasPermission(Permission.OrgEdit)"></Op>
                <Op Command="Delete" Tooltip="删除" Icon="Delete" Visible="@Auth.HasPermission(Permission.OrgDelete)"></Op>
            </EleOpColumn>
            <EleColumn For="Item.Name" Label="名称" MinWidth="300"></EleColumn>
            <EleColumn For="Item.Code" Label="编码" Width="100"></EleColumn>
            <EleColumn For="Item.Level" Label="级别" Width="100"></EleColumn>
            <EleColumn For="Item.FullName" Label="全称" MinWidth="300"></EleColumn>
            <EleColumn For="Item.Id" Label="ID" Width="100"></EleColumn>
            <EleColumn For="Item.SortId" Label="排序" Width="80"></EleColumn>
        </Columns>
    </EleTable>
}

